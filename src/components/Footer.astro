---
import { CONFIG, waLink, ir, sec as secEnlace } from '../data/site';
import { SOCIAL_ICONS } from '../lib/social';
import { Picture } from 'astro:assets';
import logoImg from '../assets/img/logo.png';

/* Las secciones viven en la portada: desde el catálogo o la ficha de un
   disfraz los enlaces tienen que apuntar allá, no a un ancla local. */
const { pagina = 'inicio' } = Astro.props as { pagina?: 'inicio' | 'catalogo' | 'disfraz' };
const enCat = pagina === 'catalogo';
const sec = (h: string) => secEnlace(h, pagina);
/* "Catálogo" apunta a la página del catálogo completo */
const urlCat = enCat ? '#catalogo' : ir('/catalogo/');
const waFoot = waLink('¡Hola! Quiero cotizar el arriendo de disfraces para adultos en La Mágica Tienda.');

const fLink = 'hf-a';

/* ═══ Escenografía dibujada en el build ═══════════════════════════════════
   Todo esto es decorativo (aria-hidden): no reemplaza ningún texto. */

/* ── Zombi en pixel art (estilo Minecraft) ──
   Cada pieza es un rectángulo sobre una rejilla de 12 × 20. */
const C = {
  piel: '#5aa63c',
  pielO: '#356b26',
  pielC: '#7ecf60',
  ojo: '#0d1a0b',
  boca: '#26441b',
  camisa: '#2f7f9b',
  camisaO: '#1d5670',
  pant: '#333c7d',
  pantO: '#1e2450',
  baba: '#a8ff3e',
};
type Bloque = [number, number, number, number, string];
const piezas: Bloque[] = [
  /* cabeza */
  [2, 0, 8, 8, C.piel],
  [2, 0, 8, 1.6, C.pielO],
  [2, 1.6, 1, 6.4, C.pielO],
  [9, 1.6, 1, 6.4, C.pielO],
  [3, 3, 2, 1.6, C.ojo],
  [7, 3, 2, 1.6, C.ojo],
  [3.3, 3.2, 0.7, 0.7, C.pielC],
  [7.3, 3.2, 0.7, 0.7, C.pielC],
  [4, 6, 4, 1, C.boca],
  [5.4, 6.8, 1.2, 1.5, C.baba],
  /* tronco */
  [2, 8, 8, 6, C.camisa],
  [2, 8, 8, 1, C.camisaO],
  [2, 13, 8, 1, C.camisaO],
  [4, 10, 3, 2, C.baba],
  /* brazos */
  [0, 8, 2, 5, C.camisa],
  [10, 8, 2, 5, C.camisa],
  [0, 13, 2, 2, C.piel],
  [10, 13, 2, 2, C.piel],
  /* piernas */
  [2, 14, 4, 5, C.pant],
  [6, 14, 4, 5, C.pant],
  [2, 19, 4, 1, C.pantO],
  [6, 19, 4, 1, C.pantO],
  [3, 16, 1, 1, C.pantO],
  [7, 17, 1, 1, C.pantO],
];
/* ── Perro zombi, mismo estilo: rejilla de 24 × 15 ── */
const piezasPerro: Bloque[] = [
  /* orejas */
  [4, 0.2, 2.6, 3.2, C.pielO],
  [8.2, 0.2, 2.6, 3.2, C.pielO],
  /* cabeza */
  [3, 3, 7.6, 6.4, C.piel],
  [3, 3, 7.6, 1.2, C.pielO],
  [3, 3, 1, 6.4, C.pielO],
  [9.6, 4.2, 1, 5.2, C.pielO],
  /* ojos */
  [4.4, 5, 2, 1.5, C.ojo],
  [7.8, 5, 1.8, 1.5, C.ojo],
  [4.7, 5.2, 0.6, 0.6, C.pielC],
  [8, 5.2, 0.6, 0.6, C.pielC],
  /* hocico */
  [0, 6.6, 3.4, 3, C.piel],
  [0, 6.6, 3.4, 1, C.pielO],
  [0.2, 7.5, 1.5, 1.3, C.ojo],
  [1.9, 8.8, 1.5, 1.7, C.baba],
  /* cuello */
  [10.2, 5, 1.6, 3.6, C.piel],
  /* cuerpo */
  [11.6, 4.6, 9.4, 6, C.piel],
  [11.6, 4.6, 9.4, 1.2, C.pielO],
  [11.6, 9.4, 9.4, 1.2, C.pielO],
  [14, 6.6, 3.6, 2, C.baba],
  /* cola */
  [21, 3.2, 2.4, 2.2, C.piel],
  [22.6, 1.6, 1.8, 2, C.pielO],
  /* patas: las de atrás un poco más oscuras para dar profundidad */
  [12, 10.6, 2.5, 3.4, C.piel],
  [14.8, 10.6, 2.2, 3, C.pielO],
  [18.2, 10.6, 2.5, 3.4, C.piel],
  [20.6, 10.6, 2.2, 3, C.pielO],
  [12, 13.3, 2.5, 0.95, C.pielO],
  [18.2, 13.3, 2.5, 0.95, C.pielO],
];

const dibujo = (viewBox: string, bloques: Bloque[]) =>
  `<svg class="hf-zsv" viewBox="${viewBox}" aria-hidden="true">${bloques
    .map(([x, y, w, h, c]) => `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="${c}"/>`)
    .join('')}</svg>`;

const zombi = dibujo('0 0 12 20', piezas);
const perro = dibujo('0 0 24 15', piezasPerro);

/* ── La sangre: el charco y las gotas que saltan al morir ── */
const sangre = `<span class="hf-sangre"></span>${[-22, -11, 7, 19]
  .map((dx) => `<i class="hf-gota" style="--dx:${dx}px"></i>`)
  .join('')}`;
const criatura = (cuerpo: string) => cuerpo + sangre;

/* ── Telaraña de la esquina (se calcula en el build) ── */
const telarana = (() => {
  const radios = [30, 56, 82, 108];
  const angulos = [0, 22.5, 45, 67.5, 90];
  const punto = (r: number, a: number) => {
    const rad = (a * Math.PI) / 180;
    return [+(Math.cos(rad) * r).toFixed(2), +(Math.sin(rad) * r).toFixed(2)];
  };
  const hilos = angulos
    .map((a) => {
      const [x, y] = punto(122, a);
      return `<path d="M0 0 ${x} ${y}"/>`;
    })
    .join('');
  const arcos = radios
    .map((r) =>
      angulos
        .slice(0, -1)
        .map((a, i) => {
          const [x1, y1] = punto(r, a);
          const [x2, y2] = punto(r, angulos[i + 1]);
          const [cx, cy] = punto(r * 0.88, (a + angulos[i + 1]) / 2);
          return `<path d="M${x1} ${y1} Q${cx} ${cy} ${x2} ${y2}"/>`;
        })
        .join(''),
    )
    .join('');
  return `<svg class="hf-web-svg" viewBox="0 0 124 124" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true">${hilos}${arcos}</svg>`;
})();

/* ── Aranita colgando ── */
const aranita = `<svg class="hf-spider-svg" viewBox="0 0 12 12" aria-hidden="true">
  <ellipse cx="6" cy="7.3" rx="2.6" ry="3" fill="#170b29"/>
  <ellipse cx="6" cy="4.2" rx="1.8" ry="1.7" fill="#1e1135"/>
  <path d="M3.4 5.6 1 3.8M3.4 7.2 1 7.2M3.4 8.8 1 10.6M8.6 5.6 11 3.8M8.6 7.2 11 7.2M8.6 8.8 11 10.6" stroke="#170b29" stroke-width="1.1" stroke-linecap="round" fill="none"/>
  <circle cx="5.2" cy="3.8" r=".55" fill="#a8ff3e"/><circle cx="6.8" cy="3.8" r=".55" fill="#a8ff3e"/>
</svg>`;

/* ── Lápida ── */
const lapida = (cruz: boolean) => `<svg class="hf-tomb-svg" viewBox="0 0 60 84" aria-hidden="true">
  <path d="M1.5 84V30a28.5 28.5 0 0 1 57 0v54z" fill="currentColor"/>
  <path d="M1.5 84V30a28.5 28.5 0 0 1 57 0v54z" fill="none" stroke="rgba(255,255,255,.10)" stroke-width="2"/>
  ${
    cruz
      ? '<path d="M26 42h8v28h-8zM16 52h28v8H16z" fill="rgba(9,4,18,.5)"/>'
      : '<path d="M11 58h38v3.5H11zM11 66h26v3H11z" fill="rgba(9,4,18,.4)"/>'
  }
</svg>`;

/* ── Murciélago (silueta dibujada: el pie no suma ni una letra) ── */
const murcielago = `<svg class="hf-bat-svg" viewBox="0 0 60 26" fill="currentColor" aria-hidden="true">
  <path d="M26 9C17 3 8 3 1 8c6 2 8 4 10 7 2-3 4-3 6 1 3-3 6-4 9-1z"/>
  <path d="M34 9c9-6 18-6 25-1-6 2-8 4-10 7-2-3-4-3-6 1-3-3-6-4-9-1z"/>
  <ellipse cx="30" cy="13.5" rx="4.4" ry="6.1"/>
  <path d="M27.2 8.2l-2-5.2 4 2.6zM32.8 8.2l2-5.2-4 2.6z"/>
</svg>`;

/* ── Árbol seco (ramas trazadas al estilo del sitio) ── */
const arbol = `<svg class="hf-tree-svg" viewBox="0 0 120 170" fill="none" stroke="currentColor"
  stroke-width="6" stroke-linecap="round" aria-hidden="true">
  <path d="M60 170V86"/>
  <path d="M60 120 26 88"/>
  <path d="M60 106 98 76"/>
  <path d="M60 96 40 58"/>
  <path d="M60 92 88 50"/>
  <path d="M26 88 15 70"/>
  <path d="M98 76 111 58"/>
  <path d="M40 58 30 38"/>
  <path d="M88 50 98 30"/>
  <path d="M60 86 58 52"/>
</svg>`;

/* ── Estrellas: posiciones fijas para que el sitio se arme igual siempre ── */
const estrellas = [
  [4, 16], [9, 62], [14, 10], [20, 44], [26, 96], [32, 28], [38, 74], [44, 12],
  [51, 58], [57, 104], [63, 34], [69, 78], [75, 18], [81, 50], [87, 88], [92, 26], [96, 66],
];

/* ── Baba que gotea desde el borde de arriba ── */
const gotas = [
  { x: 3, w: 18, h: 40, d: '0s' },
  { x: 11, w: 12, h: 26, d: '-1.4s' },
  { x: 20, w: 22, h: 54, d: '-3.1s' },
  { x: 32, w: 14, h: 32, d: '-2.2s' },
  { x: 43, w: 20, h: 46, d: '-4.3s' },
  { x: 56, w: 12, h: 24, d: '-0.8s' },
  { x: 65, w: 24, h: 58, d: '-5.1s' },
  { x: 78, w: 15, h: 34, d: '-2.7s' },
  { x: 88, w: 20, h: 48, d: '-3.8s' },
];
---

<footer class="hf-foot">
  {/* ═══ Cielo, niebla, cementerio y baba (sólo decoración) ═══ */}
  <div class="hf-bg" aria-hidden="true">
    <span class="hf-moon"></span>
    {
      estrellas.map(([x, y], i) => (
        <i class="hf-star" style={`left:${x}%;top:${y}px;animation-delay:${((i % 7) * 0.6).toFixed(1)}s`} />
      ))
    }
    <i class="hf-bat hf-bat-1" style="animation-delay:0s" set:html={murcielago} />
    <i class="hf-bat hf-bat-2" style="animation-delay:-4s" set:html={murcielago} />
    <i class="hf-bat hf-bat-3" style="animation-delay:-7.5s" set:html={murcielago} />

    <span class="hf-web" set:html={telarana} />
    <span class="hf-spider" set:html={aranita} />

    <div class="hf-fog hf-fog-a"></div>
    <div class="hf-fog hf-fog-b"></div>
    <div class="hf-fog hf-fog-c"></div>

    <span class="hf-tree hf-tree-l" set:html={arbol} />
    <span class="hf-tree hf-tree-r" set:html={arbol} />
    <span class="hf-tomb hf-tomb-1" set:html={lapida(true)} />
    <span class="hf-tomb hf-tomb-2" set:html={lapida(false)} />
    <span class="hf-tomb hf-tomb-3" set:html={lapida(true)} />
    <span class="hf-tomb hf-tomb-4" set:html={lapida(false)} />

    <div class="hf-ground"></div>
    <div class="hf-puddle hf-puddle-1"></div>
    <div class="hf-puddle hf-puddle-2"></div>
    <div class="hf-puddle hf-puddle-3"></div>

    {/* La baba entra desde el borde de arriba, como si el fondo se derritiera */}
    <div class="hf-slime">
      {
        gotas.map((g) => (
          <i
            class="hf-drip"
            style={`left:${g.x}%;width:${g.w}px;height:${g.h}px;animation-delay:${g.d}`}
          />
        ))
      }
    </div>
  </div>

  {/* ═══ Los zombis y el perro zombi: al tocarlos caen y se desangran ═══ */}
  <button type="button" class="hf-z hf-z-1" data-zombi aria-label="Zombi" set:html={criatura(zombi)} />
  <button type="button" class="hf-z hf-z-2" data-zombi aria-label="Zombi" set:html={criatura(zombi)} />
  <button type="button" class="hf-z hf-perro" data-zombi aria-label="Perro zombi" set:html={criatura(perro)} />

  <div class="hf-in mx-auto max-w-[1220px]">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-[26px]">
      <div>
        <span class="hf-placa">
<Picture
            class="footer-logo"
            src={logoImg}
            alt="La Mágica Tienda de Disfraces"
            widths={[128, 256, 384]}
            sizes="200px"
            formats={['avif', 'webp']}
            loading="lazy"
          />
        </span>
        <p class="hf-p my-2.5">
          Arriendo de disfraces solo para adultos en Punta Arenas, Región de Magallanes. #lamagicatienda
        </p>
        <div class="flex gap-2">
          {
            CONFIG.redes.map((r) => (
              <a class="hf-soc" href={r.u} target="_blank" rel="noopener" aria-label={r.n}>
                <span set:html={SOCIAL_ICONS[r.n] ?? r.i} />
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <h3 class="hf-h">Explora</h3>
        <a class={fLink} href={urlCat}>Catálogo</a>
        <a class={fLink} href={sec('#promos')}>Promos</a>
        <a class={fLink} href={sec('#fechas')}>Fechas</a>
        <a class={fLink} href={sec('#pagos')}>💳 Pagos</a>
      </div>

      <div>
        <h3 class="hf-h">Arriendo</h3>
        <button class="hf-a hf-btn" data-opencond>
          🛡️ Condiciones
        </button>
        <a class={fLink} href={sec('#como')}>🪄 Cómo funciona</a>
        <a class={fLink} href={sec('#faq')}>❓ Preguntas</a>
      </div>

      <div>
        <h3 class="hf-h">Horarios y contacto</h3>
        <p class="hf-p hf-p-horario">
          <span data-horario>Lun–Sáb 15:00–20:30 · Dom cerrado</span> 😴
        </p>
        <a class={fLink} href={CONFIG.telHref}>📞 {CONFIG.tel}</a>
        <a class={fLink} href={waFoot} target="_blank" rel="noopener">💬 {CONFIG.waDisplay}</a>
      </div>
    </div>

    <p class="hf-copy mt-[30px] text-center text-[.875rem]">
      © 2026 La Mágica Tienda de Disfraces · Arriendo de disfraces para adultos · Punta Arenas
    </p>

    <p class="mt-4 text-center">
      <a class="fhl-credit" href="https://fractalhost.cl" target="_blank" rel="nofollow noopener">
        <span class="fhl-dot" aria-hidden="true"></span>
        Sitio creado por <b>Fractalhost.cl</b>
      </a>
    </p>
  </div>
</footer>
