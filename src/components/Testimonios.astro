---
import { PRODUCTS } from '../data/products';
import { TESTIS } from '../data/site';

/* Galería: 6 fotos reales del catálogo */
const galeria = [1, 4, 19, 20, 37, 51]
  .map((id) => PRODUCTS.find((p) => p.id === id))
  .filter(Boolean) as typeof PRODUCTS;
---

<section id="testimonios" class="relative px-4 py-[46px]">
  <div class="mx-auto max-w-[1220px]">
    <h2 class="sec rv">💜 Fiestas que brillaron</h2>

    <div class="rv relative mx-auto max-w-[760px] overflow-hidden rounded-[22px]">
      <div id="testiTrack" class="flex transition-transform duration-500 [transition-timing-function:cubic-bezier(.2,.8,.25,1)]">
        {
          TESTIS.map((t) => (
            <div class="min-w-full border-[1.5px] border-line bg-white px-[26px] py-[30px] text-center text-ink shadow-[0_8px_20px_rgba(90,42,156,.08)]">
              <span class="text-[2.4rem]">{t.e}</span>
              <div class="tracking-[2px] text-[#e8a200]">{'★'.repeat(t.s)}{'☆'.repeat(5 - t.s)}</div>
              <p class="my-2.5 min-h-[3.2em] text-[1.05rem] text-[#4a3c78]">“{t.t}”</p>
              <b class="font-extrabold text-m600">{t.n}</b>
              <span class="text-[.8rem] text-ink2"> · {t.r}</span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-3.5 flex items-center justify-center gap-2.5">
      <button id="testiPrev" class="grid h-10 w-10 cursor-pointer place-items-center rounded-full border-[1.5px] border-line bg-white text-[1rem] text-m600" aria-label="Anterior">‹</button>
      <span id="testiDots" class="flex gap-1.5"></span>
      <button id="testiNext" class="grid h-10 w-10 cursor-pointer place-items-center rounded-full border-[1.5px] border-line bg-white text-[1rem] text-m600" aria-label="Siguiente">›</button>
    </div>

    <h2 class="sec rv mt-[44px]">📸 #lamagicatienda en acción</h2>
    <p class="sec-sub rv">Etiquétanos desde tu fiesta y aparece en nuestra galería.</p>

    <div id="instaGrid" class="rv mx-auto grid max-w-[900px] grid-cols-2 gap-2.5 min-[700px]:grid-cols-3">
      {
        galeria.map((g, k) => (
          <div class="ig relative aspect-square cursor-pointer overflow-hidden rounded-[14px] bg-[linear-gradient(135deg,var(--color-m400),var(--color-rosa))] grid place-items-center" tabindex="0">
            <img src={g.img} alt={`Adultos disfrazados en fiesta #lamagicatienda ${k + 1}`} loading="lazy" class="absolute inset-0 h-full w-full object-cover transition duration-500" />
            <div class="ov absolute inset-0 grid place-items-center bg-[rgb(43,13,94/.5)] text-white opacity-0 transition">
              <b>❤ {120 + k * 37}</b>
            </div>
            <button class="hbtn absolute bottom-2 right-2 z-[2] cursor-pointer rounded-full border-0 bg-white/80 px-2.5 py-1.5 text-[.8rem] font-extrabold text-[#e0245e]" data-k={k} aria-label="Me gusta">
              ❤ <span>{120 + k * 37}</span>
            </button>
          </div>
        ))
      }
    </div>
  </div>
</section>
