---
/* Prueba social: testimonios reales de TESTIS (data/site.ts) */
import { TESTIS } from '../data/site';
---

<section id="testimonios" class="relative px-4 pb-[38px]" aria-labelledby="testiT">
  <div class="mx-auto max-w-[1220px]">
    <h2 id="testiT" class="sec-sm rv">💜 Ya arrendaron con nosotros</h2>
    <p class="sec-sub rv">Clientes reales de Punta Arenas y la región.</p>
    <div class="mt-5 grid gap-4 min-[700px]:grid-cols-2 min-[1040px]:grid-cols-4">
      {
        TESTIS.map((t, k) => (
          <figure class="rv m-0 flex flex-col gap-2 rounded-2xl border-[1.5px] border-line bg-white p-5 shadow-[0_4px_12px_rgba(90,42,156,.06)]" style={`--d:${(k * 0.08).toFixed(2)}s`}>
            <div class="text-[1rem] tracking-[.12em] text-ama" aria-label={`${t.s} de 5 estrellas`}>
              {'★'.repeat(t.s)}
              <span class="text-[#d9c9f7]">{'★'.repeat(5 - t.s)}</span>
            </div>
            <blockquote class="m-0 text-[1rem] leading-relaxed text-ink">“{t.t}”</blockquote>
            <figcaption class="mt-auto flex items-center gap-2.5 pt-1">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-[#f0eaff] text-[1.2rem]" aria-hidden="true">
                {t.e}
              </span>
              <span>
                <b class="block font-ft text-[.875rem] text-ink">{t.n}</b>
                <small class="text-[.875rem] text-ink2">{t.r}</small>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
