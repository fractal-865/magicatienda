---
import { TALLA_GUIA } from '../data/products';

const steps = [
  { n: 1, i: '🎭', t: 'Elige tus disfraces', p: 'Busca, filtra y agrégalos a "Tu arriendo".' },
  { n: 2, i: '💬', t: 'Cotiza y reserva por WhatsApp', p: 'Con la reserva (valor del arriendo) aseguramos tu disfraz para la fecha.' },
  { n: 3, i: '🛡️', t: 'Retira y deja tu garantía', p: '$13.000 a $20.000 según el disfraz, en efectivo o transferencia, el día del retiro.' },
  { n: 4, i: '🎉', t: 'Usa, devuelve y recupera tu garantía', p: 'Si vuelve en las mismas condiciones, te la devolvemos completa.' },
];

const days = [
  { i: '📦', t: 'Retiro', s: 'Pagas la garantía ($13.000 a $20.000) en efectivo o transferencia' },
  { i: '🎉', t: 'Uso', s: 'Tu fiesta, evento o celebración' },
  { i: '↩️', t: 'Entrega', s: 'Devuelves el disfraz y recuperas tu garantía' },
];

const guiaTallas = ['XS', 'S', 'M', 'L', 'L-XL', 'XL', 'XXL'].map((k) => ({ t: k, r: TALLA_GUIA[k] }));
---

<section id="como" class="relative px-4 py-[46px]">
  <div class="mx-auto max-w-[1220px]">
    <div class="text-center"><span class="script rv">Sin misterios</span></div>
    <h2 class="sec rv">🪄 ¿Cómo funciona el arriendo?</h2>
    <p class="sec-sub rv">Cuatro pasos y listo para brillar.</p>

    <!-- Pasos -->
    <ol class="steps-wrap">
      {
        steps.map((s, k) => (
          <li class="stepcard rv" style={`--d:${(k * 0.12).toFixed(2)}s`}>
            <span class="step-n">{s.n}</span>
            <span class="step-i" aria-hidden="true">{s.i}</span>
            <b class="step-t">{s.t}</b>
            <p class="step-p">{s.p}</p>
          </li>
        ))
      }
    </ol>

    <!-- Los 3 días del arriendo -->
    <div class="como-days rv" aria-label="Los 3 días del arriendo">
      <span class="days-track" aria-hidden="true"></span>
      {
        days.map((d, k) => (
          <div class="daycard">
            <span class="day-num">Día {k + 1}</span>
            <span class="day-icon" aria-hidden="true">{d.i}</span>
            <b class="day-t">{d.t}</b>
            <small class="day-s">{d.s}</small>
          </div>
        ))
      }
    </div>

    <!-- Dos tarjetas informativas con contenido desplegable -->
    <div class="infogrid rv">
      <article class="infocard">
        <span class="info-i" aria-hidden="true">📏</span>
        <h3>Guía de tallas (adultos)</h3>
        <p class="info-s">Cada talla tiene su estatura recomendada.</p>
        <div class="info-body" id="infoGuia">
          <p class="info-h">Estatura recomendada por talla</p>
          <ul class="info-list">
            {guiaTallas.map((g) => <li><b>{g.t}</b><span>{g.r}</span></li>)}
          </ul>
          <p>
            Arrendamos solo a personas adultas. ¿Dudas? Escríbenos por WhatsApp con tu estatura y te
            recomendamos la talla exacta. 💜
          </p>
        </div>
      </article>

      <article class="infocard">
        <span class="info-i" aria-hidden="true">🛡️</span>
        <h3>Condiciones de arriendo</h3>
        <p class="info-s">Reserva, garantía y devolución, en pocas palabras.</p>
        <div class="info-body" id="infoCond">
          <p><b>Reserva.</b> El valor del arriendo asegura tu disfraz para la fecha seleccionada. Es el monto que se paga por adelantado y no es reembolsable.</p>
          <p><b>Garantía.</b> $13.000 a $20.000 según el disfraz. Se paga el día del retiro, en efectivo o transferencia, y se devuelve completa al entregar en las mismas condiciones.</p>
          <p><b>A tiempo.</b> El arriendo es de 3 días: retiro, uso y entrega. Si te atrasas, los días de más se descuentan de la garantía.</p>
          <p><b>Estado.</b> Si el disfraz vuelve con daños o manchas, se descuenta de la garantía según el arreglo correspondiente.</p>
        </div>
        <button class="btn btn-ghost btn-sm mt-3 w-full" data-opencond>
          Ver condiciones completas
        </button>
      </article>
    </div>
  </div>
</section>
