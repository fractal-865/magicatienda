---
import { TALLA_GUIA } from '../data/products';

const steps = [
  { n: 1, i: '🎭', t: 'Elige tus disfraces', p: 'Busca, filtra y agrégalos a "Tu arriendo".' },
  { n: 2, i: '💬', t: 'Cotiza y reserva por WhatsApp', p: 'Con la reserva (valor del arriendo) aseguramos tu disfraz para la fecha.' },
  { n: 3, i: '🛡️', t: 'Retira y deja tu garantía', p: '$13.000 a $20.000 según el disfraz, en efectivo o transferencia, el día del retiro.' },
  { n: 4, i: '🎉', t: 'Usa, devuelve y recupera tu garantía', p: 'Si vuelve en las mismas condiciones, te la devolvemos completa.' },
];

const days = [
  { i: '📦', t: 'Retiro', s: 'Pagas la garantía ($13.000 a $20.000) en efectivo o transferencia' },
  { i: '🎉', t: 'Uso', s: 'Tu fiesta, evento o celebración' },
  { i: '↩️', t: 'Entrega', s: 'Devuelves el disfraz y recuperas tu garantía' },
];

const guia = ['XS', 'S', 'M', 'L', 'L-XL', 'XL', 'XXL']
  .map((k) => `<b>${k}</b> (${TALLA_GUIA[k].replace(' cm o más', ' cm o más').replace(' a ', '–')})`)
  .join(' · ');

const accs = [
  {
    q: '📏 Guía de tallas (adultos)',
    a: `<b>Adultos:</b> ${guia}.<br>Arrendamos solo a personas adultas. ¿Dudas? Escríbenos por WhatsApp con tu estatura y te recomendamos la talla exacta. 💜`,
  },
  { q: '🧼 ¿Los disfraces vienen limpios?', a: 'Siempre. Cada disfraz se higieniza y revisa entre arriendo y arriendo.' },
];
---

<section id="como" class="relative px-4 py-[46px]">
  <div class="mx-auto max-w-[1220px]">
    <div class="text-center"><span class="script rv">Sin misterios</span></div>
    <h2 class="sec rv">🪄 ¿Cómo funciona el arriendo?</h2>
    <p class="sec-sub rv">Cuatro pasos y listo para brillar.</p>

    <!-- Pasos -->
    <ol class="steps-wrap">
      {
        steps.map((s, k) => (
          <li class="stepcard rv" style={`--d:${(k * 0.12).toFixed(2)}s`}>
            <span class="step-n">{s.n}</span>
            <span class="step-i" aria-hidden="true">{s.i}</span>
            <b class="step-t">{s.t}</b>
            <p class="step-p">{s.p}</p>
          </li>
        ))
      }
    </ol>

    <!-- Los 3 días del arriendo -->
    <div class="como-days rv" aria-label="Los 3 días del arriendo">
      <span class="days-track" aria-hidden="true"></span>
      {
        days.map((d, k) => (
          <div class="daycard">
            <span class="day-num">Día {k + 1}</span>
            <span class="day-icon" aria-hidden="true">{d.i}</span>
            <b class="day-t">{d.t}</b>
            <small class="day-s">{d.s}</small>
          </div>
        ))
      }
    </div>

    <!-- Acordeones -->
    <div class="acc mx-auto mt-[26px] max-w-[760px]">
      {
        accs.map((a) => (
          <div class="acc-item mb-2.5 overflow-hidden rounded-[16px] border-[1.5px] border-line bg-white text-ink transition hover:border-m400">
            <button class="flex w-full items-center justify-between gap-2.5 bg-transparent px-[18px] py-4 text-left font-ft text-[1rem] font-semibold" aria-expanded="false">
              {a.q} <span class="ic text-[1.2rem] text-m500 transition">＋</span>
            </button>
            <div class="ab">
              <div class="ab-in px-[18px] pb-4 text-[.92rem] text-ink2" set:html={a.a} />
            </div>
          </div>
        ))
      }
      <div class="acc-item mb-2.5 overflow-hidden rounded-[16px] border-[1.5px] border-line bg-white text-ink transition hover:border-m400">
        <button class="flex w-full items-center justify-between gap-2.5 bg-transparent px-[18px] py-4 text-left font-ft text-[1rem] font-semibold" aria-expanded="false" data-opencond>
          🛡️ Condiciones de arriendo y reserva <span class="ic text-[1.2rem] text-m500 transition">＋</span>
        </button>
        <div class="ab">
          <div class="ab-in px-[18px] pb-4 text-[.92rem] text-ink2">
            Resumen: reserva = valor del arriendo (no reembolsable) · garantía de $13.000 a $20.000 se paga al
            retiro y se devuelve al entregar en las mismas condiciones.
            <button class="glink cursor-pointer border-0 bg-transparent p-0 text-[.82rem] font-extrabold text-m600 underline" data-opencond>
              Ver condiciones completas
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
