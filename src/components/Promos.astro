---
import { waLink, GAR_SHORT } from '../data/site';
import { Picture, Image } from 'astro:assets';
import promoGlobosImg from '../assets/img/promo-globos.png';
import halloweenImg from '../assets/img/halloween-grupo.svg';

const waPromo = waLink('¡Hola! Quiero cotizar el arriendo de disfraces para adultos en La Mágica Tienda.');

const benefits = [
  { i: '📅', t: 'Arriendo por 3 días', s: 'Retiro, uso y entrega' },
  { i: '📏', t: 'Tallas S a XXL', s: 'Solo adultos' },
  { i: '💬', t: 'Cotiza por WhatsApp', s: 'Respuesta en minutos' },
  { i: '🛡️', t: 'Garantía clara', s: `${GAR_SHORT}, se devuelve` },
];
---

<section id="promos" class="relative px-4 py-[46px]">
  <div class="mx-auto max-w-[1220px]">
    <!-- Slide de banners: la tarjeta de Halloween aparece primero -->
    <div class="promo-wrap relative">
      <div id="promoTrack" class="promo-track">
      <!-- Banner principal: primera pantalla con la promesa única (H1) -->
      <div class="promo-card rv relative flex min-h-[310px] flex-col justify-center gap-2.5 overflow-hidden rounded-3xl bg-[linear-gradient(120deg,#2B0D5E,#5A2A9C)] p-7 text-white shadow-sh2">
<Picture
          class="absolute inset-0 h-full w-full object-cover"
          src={promoGlobosImg}
          alt="Fiesta de adultos con globos y disfraces"
          widths={[640, 960, 1280]}
          sizes="100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          onerror="this.closest('.promo-card').classList.add('imgfail');this.style.display='none'"
        />
        <div class="absolute inset-0 bg-[linear-gradient(115deg,rgba(28,8,64,.92)_25%,rgba(43,13,94,.5))]"></div>
        <div class="fbk absolute inset-0 hidden place-items-center bg-[linear-gradient(120deg,#2B0D5E,#5A2A9C)] text-[5rem]">🎭</div>
        <span class="script relative">¡Pa' tu fiesta!</span>
        <h1 class="relative text-[clamp(1.4rem,2.6vw,1.9rem)] leading-[1.15]">
          Arriendo de disfraces para adultos en <em class="not-italic text-ama">Punta Arenas</em>
        </h1>
        <p class="relative max-w-[46ch] text-[.92rem] text-lav2">
          Cumpleaños, graduaciones, fiestas de época y eventos en Punta Arenas y toda Magallanes. Cotiza por
          WhatsApp. 🌟
        </p>
        <div class="relative mt-1.5 flex flex-wrap gap-2.5">
          <a class="btn btn-ama" href="#catalogo">Ver disfraces 🎭</a>
          <a class="btn btn-wsp" href={waPromo} target="_blank" rel="noopener">Cotizar por WhatsApp 💬</a>
        </div>
      </div>

      <!-- Banner Halloween (temporada; la urgencia también vive en la barra superior) -->
      <div
        class="promo-card rv relative flex min-h-[310px] flex-col justify-center gap-2.5 overflow-hidden rounded-3xl bg-[linear-gradient(130deg,#1c0840,#3c1481_70%,#7a3a10)] p-7 text-white shadow-sh2"
        style="--d:.1s"
      >
        <!-- Amigos disfrazados de Halloween celebrando -->
<Image
          class="absolute inset-0 h-full w-full object-cover object-[70%_center]"
          src={halloweenImg}
          alt="Grupo de amigos disfrazados de Halloween celebrando"
          width={1200}
          height={600}
          loading="lazy"
          onerror="this.style.display='none'"
        />
        <div
          class="absolute inset-0 bg-[linear-gradient(115deg,rgba(20,6,48,.95)_18%,rgba(35,11,80,.72)_52%,rgba(60,20,129,.35))]"
        >
        </div>
        <span class="cb-bal absolute right-[10%] top-[10%] text-[2rem] opacity-85">🎃</span>
        <span class="script relative">Se viene el terror divertido…</span>
        <h2 class="relative text-[clamp(1.4rem,2.6vw,1.9rem)] leading-[1.15]">
          Halloween se acerca… <em class="not-italic text-ama">uuuh 👻</em>
        </h2>
        <div id="cdBanner" class="cdbox relative flex flex-wrap gap-2" aria-label="Cuenta regresiva a Halloween"></div>
        <div class="relative mt-1.5 flex flex-wrap gap-2.5">
          <button class="btn btn-ama" id="halloCTA">Armar mi look 🧛</button>
        </div>
      </div>

      <!-- Banner Cómo llegar (lleva a la sección del mapa) -->
      <div class="promo-card rv relative flex min-h-[310px] flex-col justify-center gap-2.5 overflow-hidden rounded-3xl bg-[linear-gradient(120deg,var(--color-rosa),#c22a7a_50%,var(--color-m600))] p-7 text-white shadow-sh2" style="--d:.2s">
        <span class="cb-bal absolute right-[8%] top-[10%] text-[2rem] opacity-85">📍</span>
        <span class="cb-bal absolute bottom-[12%] right-[20%] text-[2rem] opacity-85" style="animation-delay:1s">🗺️</span>
        <span class="script relative text-white">Te esperamos en la tienda</span>
        <div class="relative font-ft text-[3.1rem] leading-none text-ama [text-shadow:0_5px_0_rgba(0,0,0,.18)]">Cómo llegar</div>
        <p class="relative max-w-[46ch] text-[.92rem] text-lav2">
          <b>Hermann Wiegartt 01194</b>, a pasos del Mall Pionero en Punta Arenas. Retiro en tienda de lunes a sábado.
        </p>
        <div class="relative mt-1.5 flex flex-wrap gap-2.5">
          <a class="btn btn-ama" href="#mapa">Ver en el mapa 🗺️</a>
        </div>
      </div>
      </div>

      <!-- Flechas: solo en móvil y tablet, donde las tarjetas van de a una.
           Sin puntos ni paginación: dos botones que saltan de banner. -->
      <button
        type="button"
        class="promo-nav promo-prev"
        id="promoPrev"
        aria-label="Banner anterior"
      >
        ‹
      </button>
      <button
        type="button"
        class="promo-nav promo-next"
        id="promoNext"
        aria-label="Banner siguiente"
      >
        ›
      </button>
      <!-- Pausa del cambio automático (WCAG 2.2.2). Solo se ve donde rota. -->
      <button
        type="button"
        class="promo-pause"
        id="promoPause"
        aria-label="Pausar el cambio automático de banners"
        aria-pressed="false"
      >
        ⏸
      </button>
    </div>

    <!-- Beneficios -->
    <div class="mt-6 grid grid-cols-2 gap-3 py-2 min-[820px]:grid-cols-4">
      {
        benefits.map((b, k) => (
          <div class="rv flex items-center gap-3 rounded-2xl border-[1.5px] border-line bg-white p-3.5 shadow-[0_4px_12px_rgba(90,42,156,.06)] transition hover:-translate-y-1 hover:border-m400 hover:shadow-sh" style={`--d:${(k * 0.1).toFixed(1)}s`}>
            <span class="text-[1.7rem]">{b.i}</span>
            <div>
              <b class="block font-ft text-[.95rem] text-ink">{b.t}</b>
              <small class="text-[.78rem] text-ink2">{b.s}</small>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <script>
    /* En el móvil los banners se rotan solos: se avanza cada 5 s y al llegar
       al último se vuelve al primero, en bucle. En pantallas grandes se ven
       varios a la vez y el carrusel no hace falta. Se detiene cuando la
       persona toca la tira, para no pelearse con su dedo. */
    const track = document.getElementById('promoTrack');
    const btnPrev = document.getElementById('promoPrev');
    const btnNext = document.getElementById('promoNext');
    const btnPause = document.getElementById('promoPause');
    if (track) {
      const movido = matchMedia('(max-width: 899px)');
      // Este script va en su propio módulo: no alcanza el `reduced()` de site.ts.
      const sinMovimiento = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const cards = () => [...track.querySelectorAll<HTMLElement>('.promo-card')];
      let i = 0;
      let timer: number | undefined;
      let pausado = false;

      /* El botón de pausa es el control que pide WCAG 2.2.2: el carrusel no
         puede avanzar solo para siempre sin una forma de detenerlo. */
      const pintarPausa = () => {
        if (!btnPause) return;
        btnPause.setAttribute('aria-pressed', String(pausado));
        btnPause.setAttribute('aria-label', pausado ? 'Reanudar el cambio automático de banners' : 'Pausar el cambio automático de banners');
        btnPause.textContent = pausado ? '▶' : '⏸';
      };

      /* Centra la tarjeta n en la tira. Antes esto usaba siempre la primera
         tarjeta, así que el avance se quedaba quieto en el banner 1. */
      const irA = (n: number) => {
        const t = cards();
        if (!t.length) return;
        i = (n + t.length) % t.length;
        const c = t[i];
        track.scrollTo({ left: c.offsetLeft - (track.clientWidth - c.clientWidth) / 2, behavior: 'smooth' });
      };

      /* Al terminar el desplazamiento suave, el índice real puede haber
         cambiado (el usuario arrastró la tira): se vuelve a leer de la
         posición para que la flecha siga desde donde quedó. */
      let ReadIndex: number | undefined;
      const leerIndice = () => {
        const t = cards();
        if (!t.length) return;
        let mejor = 0;
        let dist = Infinity;
        for (const [k, c] of t.entries()) {
          const centro = c.offsetLeft + c.clientWidth / 2;
          const d = Math.abs(centro - (track.scrollLeft + track.clientWidth / 2));
          if (d < dist) {
            dist = d;
            mejor = k;
          }
        }
        i = mejor;
      };

      const parar = () => {
        if (timer) clearInterval(timer);
        timer = undefined;
      };
      let reanudarT: number | undefined;
      const reanudar = () => {
        if (reanudarT) clearTimeout(reanudarT);
        reanudarT = window.setTimeout(girar, 6000);
      };
      const girar = () => {
        parar();
        if (pausado || !movido.matches || sinMovimiento) return;
        timer = window.setInterval(() => irA(i + 1), 5000);
      };

      const tocar = (delta: number) => {
        parar();
        irA(i + delta);
        // Tras una pausa sin tocar, el carrusel vuelve a arrancar solo.
        reanudar();
      };

      btnPrev?.addEventListener('click', () => tocar(-1));
      btnNext?.addEventListener('click', () => tocar(1));
      btnPause?.addEventListener('click', () => {
        pausado = !pausado;
        pintarPausa();
        if (pausado) parar();
        else girar();
      });
      pintarPausa();

      girar();
      movido.addEventListener('change', girar);
      // Arrastrar la tira a mano manda sobre el temporizador, pero no lo mata:
      // se lee en qué banner quedó y el bucle sigue desde ahí.
      const alTocar = () => {
        parar();
        reanudar();
      };
      track.addEventListener('touchstart', alTocar, { passive: true });
      track.addEventListener('wheel', alTocar, { passive: true });
      track.addEventListener('scroll', () => {
        if (timer) leerIndice();
      }, { passive: true });
      document.addEventListener('visibilitychange', girar);
    }
  </script>
</section>
