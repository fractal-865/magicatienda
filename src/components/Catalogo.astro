---
import { CATS_ACTIVE, PUBLICOS, TALLAS, PRODUCTS, TALLA_GUIA } from '../data/products';
import { ir, SEO_CAT } from '../data/site';
import { cardHTML } from '../lib/card';

/* Dos modos del mismo componente:
   · portada  → escaparate de la portada: 26 disfraces + enlace al catálogo completo.
   · catalogo → la página /catalogo/: todo el catálogo, con filtros y carga por tandas.
   La barra de filtros, el grid, los chips y el modal son idénticos en ambos. */
const { modo = 'portada' } = Astro.props as { modo?: 'portada' | 'catalogo' };
const esCat = modo === 'catalogo';

const catCount = (id: string) => PRODUCTS.filter((p) => p.cats.includes(id)).length;
const total = PRODUCTS.length;
// El desplegable va de la categoría con más disfraces a la que tiene menos.
const catsPorCantidad = [...CATS_ACTIVE]
  .map((c) => ({ ...c, count: catCount(c.id) }))
  .sort((a, b) => b.count - a.count);
const urlCatalogo = ir('/catalogo/');
---

<section
  id="catalogo"
  data-modo={esCat ? 'catalogo' : undefined}
  class="relative px-4 pb-[46px] pt-[30px]"
>
  <!-- El H1 sigue en el HTML para SEO y lectores de pantalla, pero la página
       ahora abre directo con las categorías y el catálogo. -->
  {esCat && <h1 class="sr-only">🎭 {SEO_CAT.h1}</h1>}

  <div class="mx-auto max-w-[1220px]">
    {
      !esCat && (
        <>
          <div class="text-center"><span class="script rv">¡Elige y brilla!</span></div>
          <h2 class="sec rv">🎭 Elige tu disfraz en Punta Arenas</h2>
          <p class="sec-sub rv">
            Tenemos <strong class="font-extrabold text-m600">{total} disfraces</strong> disponibles para tu
            elección.
            <span class="mt-1 block text-[.9375rem]">
              Arriendo solo para adultos · 3 días (retiro, uso y entrega) · Cotiza por WhatsApp en 1 minuto.
            </span>
          </p>
        </>
      )
    }

    {
      !esCat && (
        <div class="rv mb-4 flex flex-wrap items-center gap-2.5">
          <span id="countLabel" class="ml-auto text-[.875rem] font-bold text-ink2" aria-live="polite"></span>
        </div>
      )
    }

    {
      esCat && (
        /* Carrusel de las categorías principales: al tocar una se filtra el catálogo */
        <div id="catCards" class="cat-cards">
          <div class="cat-cards-head">
            <h2 class="cat-cards-t">Explora por tipo de disfraz 🎭</h2>
            <div class="ct-nav">
              <button class="ct-arrow" data-ct="-1" type="button" aria-label="Categorías anteriores">
                ‹
              </button>
              <button class="ct-arrow" data-ct="1" type="button" aria-label="Ver más categorías">
                ›
              </button>
            </div>
            <button
              id="ctPause"
              class="ct-pause"
              type="button"
              aria-pressed="false"
              aria-label="Pausar el carrusel de categorías"
            >
              ⏸
            </button>
          </div>
          <div id="ctTrack" class="ct-track">
            {catsPorCantidad.map((c, i) => (
              <a
                class="ct-card"
                data-tem={c.id}
                href={ir(`/catalogo/?tem=${c.id}`)}
                style={`--c1:${c.g[0]};--c2:${c.g[1]};--d:${i * 60}ms`}
              >
                <span class="ct-emoji" aria-hidden="true">{c.i}</span>
                <span class="ct-nombre">{c.n}</span>
                <span class="ct-cuenta">{c.count} disfraces</span>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>

  <!-- Barra fija de filtros: buscador + categorías + público + talla + filtros activos.
       Vive fuera del contenedor para que, al quedar pegada bajo el header, se expanda
       a todo el ancho con un fondo más oscuro. Nunca ocupa más de 2 filas. -->
  <div id="fbar" class="fbar">
    <div class="fbar-in">
      <div id="catFilters" class="cat-filters">
        <div class="cat-filters-main">
          <!-- Fila 1 (móvil): buscador + categorías + limpiar -->
          <div class="cf-line cf-line-1">
            <!-- Buscador: plegable, empieza como solo lupa -->
            <div class="searchbox searchbox-sm" role="search">
              <button id="searchToggle2" class="sb-toggle" aria-label="Abrir buscador" aria-expanded="false">🔍</button>
              <input
                id="catSearch"
                type="search"
                placeholder="Busca 'bruja', 'vampiro', 'Halloween'…"
                aria-label="Buscar en catálogo"
                autocomplete="off"
              />
            </div>

            <!-- Categorías: el listado se despliega desde la barra -->
            <button id="catDropBtn" class="chip cat-pick-btn" aria-expanded="false" aria-controls="catDrop" aria-label="Categorías">
              <span aria-hidden="true">🎭</span> <span class="cat-pick-t">Categorías</span>
              <span id="catDropN" class="cat-pick-n hidden" aria-hidden="true">0</span>
              <i class="cat-pick-c" aria-hidden="true"></i>
            </button>

            <button id="catClear" class="chip chip-clear hidden" aria-label="Limpiar todos los filtros">
              <span class="chip-clear-count" id="catClearCount">0</span>
              Limpiar
            </button>
          </div>

          <!-- Fila 2: filtros activos + público + talla. El celular nunca pasa de 2 filas:
               los filtros activos entran aquí, al principio de la fila. -->
          <div class="cf-line cf-line-2">
            <!-- Categoría activa: un pill con su nombre y una X para quitarla.
                 En escritorio ocupa su propia fila; en móvil va al inicio de la 2ª. -->
            <div id="activeChips" class="active-chips" role="group" aria-label="Filtros activos"></div>

            <div class="qf-group">
              <div class="qf-chips">
                {PUBLICOS.map((p) => <button class="chip fchip" data-g="pub" data-v={p.id}>{p.i} {p.n}</button>)}
              </div>
            </div>

            <div class="qf-group">
              <div class="qf-chips">
                {TALLAS.map((t) => <button class="chip fchip tip" data-g="tal" data-v={t} data-tip={TALLA_GUIA[t] ? TALLA_GUIA[t] : 'Sin referencia de estatura'}>{t}</button>)}
              </div>
            </div>
          </div>
        </div>

        <!-- Listado de categorías -->
        <div id="catDrop" class="cat-drop" role="group" aria-label="Filtrar por categoría">
          <div class="cat-drop-head">
            <b class="font-ft">Categorías ✨</b>
            <button id="clearFilters" class="cat-drop-clear">Limpiar todo</button>
          </div>

          <div id="filterGroups" class="cat-drop-list">
            {
              catsPorCantidad.map((c) => (
                <label class="cat-opt">
                  <input type="checkbox" data-g="tem" value={c.id} class="h-[17px] w-[17px] accent-m500" />
                  <span class="cat-opt-n">{c.i} {c.n}</span>
                  <small class="cat-opt-c">{c.count}</small>
                </label>
              ))
            }
          </div>
        </div>

        <div
          id="sugCat"
          class="suggest absolute inset-x-0 top-[calc(100%+6px)] z-[70] max-h-[340px] overflow-y-auto rounded-2xl border-2 border-line bg-white shadow-sh2"
          role="listbox"></div>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-[1220px]">
    <!-- Encabezado de la grilla: el contador vive pegado a los resultados y
         el h2 mantiene el orden de encabezados (h1 → h2 → h3 del pie). -->
    {esCat && (
      <div class="cat-results">
        <span id="countLabel" class="cat-cuenta" aria-live="polite">{total} disfraces para arrendar</span>
      </div>
    )}
    {esCat && <h2 class="sr-only">Disfraces disponibles para arrendar</h2>}

    <!-- En /catalogo/ las 156 tarjetas salen en el HTML (los buscadores ven los
         enlaces desde el primer byte). El navegador toma el control en cuanto
         arranca: filtra, reordena y deja solo la primera tanda. -->
    <div id="grid" class="grid grid-cols-[repeat(auto-fill,minmax(215px,1fr))] gap-4" data-ssr={esCat ? '' : undefined}>
      {esCat && PRODUCTS.map((c, k) => <Fragment set:html={cardHTML(c, k)} />)}
    </div>

    <script is:inline>
      // Red de seguridad: si el JS de la página no llega a arrancar (módulo caído,
      // red cortada, un 502 pasajero), el catálogo no puede quedarse en 12 de 156
      // tarjetas. Pasado un margen se muestran todas, aunque sea sin filtros.
      addEventListener('DOMContentLoaded', function () {
        setTimeout(function () {
          var g = document.getElementById('grid');
          if (g && g.hasAttribute('data-ssr')) g.removeAttribute('data-ssr');
        }, 3000);
      });
    </script>

    {
      esCat ? (
        /* Catálogo completo: al llegar al final se cargan más por tandas (el botón
           queda como respaldo y el contador dice cuántos faltan por ver). */
        <div id="loadWrap" class="mt-6 hidden text-center">
          <!-- Barra de avance: con 156 disfraces y carga automática, sin esto
               la lista parece no terminar nunca. Dice cuántos llevas y cuántos
               quedan, y al cargar se pone en movimiento. -->
          <div class="loadprog" id="loadProg" role="status" aria-live="polite">
            <span class="loadprog-track"><span class="loadprog-fill" id="loadFill"></span></span>
            <span class="loadprog-txt">
              <span class="loadspin" id="loadSpin" aria-hidden="true"></span>
              <span id="loadInfo"></span>
            </span>
          </div>
          <button id="loadMore" class="btn btn-ghost btn-sm mt-3">Cargar más disfraces</button>
        </div>
      ) : (
        /* Portada: solo se ven 20 disfraces (12 en móvil); el resto vive en
           /catalogo/. El enlace es la salida al catálogo completo, así que
           va grande, con borde deemphasis y un halo al pasar el mouse. */
        <div class="mt-8 text-center">
          <a
            id="verTodos"
            href={urlCatalogo}
            class="inline-flex items-center justify-center gap-2.5 rounded-2xl px-8 py-5 font-ft text-[1.15rem] font-bold text-white no-underline transition duration-200 hover:-translate-y-1"
            style="background:linear-gradient(135deg,var(--color-m600),var(--color-m500));box-shadow:0 10px 26px rgb(90 42 156 / .32),0 0 0 4px rgb(122 79 208 / .12)"
          >
            <span class="text-[1.35rem] leading-none" aria-hidden="true">🎭</span>
            Ver todos los disfraces
            <span class="text-[1.05rem] leading-none opacity-80" aria-hidden="true">→</span>
          </a>
          <p id="loadInfo" class="mt-2.5 text-[.875rem] font-bold text-ink2"></p>
        </div>
      )
    }
  </div>
</section>
