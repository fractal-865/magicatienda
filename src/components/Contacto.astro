---
import { CONFIG, waLink } from '../data/site';

const waCard = waLink('¡Hola! Quiero cotizar el arriendo de un disfraz para adultos.');
const cards = [
  { c: '#25D366', i: '💬', t: 'WhatsApp', s: `${CONFIG.waDisplay}<br>Cotizaciones en minutos`, href: waCard, blank: true },
  { c: '#FF5FA2', i: '📞', t: 'Teléfono', s: CONFIG.tel, href: CONFIG.telHref },
  { c: '#e8a200', i: '✉️', t: 'Email', s: 'contacto@lamagicatienda.cl', href: 'mailto:contacto@lamagicatienda.cl' },
  { c: '#0fae9f', i: '📍', t: 'Dirección', s: CONFIG.dir, href: '#mapa' },
  { c: '#7a4fd0', i: '🕐', t: 'Horarios', s: '<span data-horario>Lun–Sáb 15:00–20:30 · Dom cerrado</span>' },
];
---

<section id="contacto" class="relative px-4 py-[46px]">
  <div class="mx-auto max-w-[1220px]">
    <h2 class="sec-sm rv">📞 Contáctanos como quieras</h2>
    <p class="sec-sub rv">Estamos para ayudarte a elegir el disfraz perfecto para tu evento.</p>

    <div class="rv grid gap-3.5 min-[960px]:grid-cols-3 min-[1200px]:grid-cols-5" id="ccards">
      {
        cards.map((c) => (
          c.href ? (
            <a
              class="block rounded-[18px] border-2 border-l-[6px] border-line bg-white p-5 text-center text-ink no-underline shadow-[0_6px_16px_rgba(90,42,156,.07)] transition hover:-translate-y-[5px] hover:shadow-sh"
              style={`border-left-color:${c.c}`}
              href={c.href}
              target={c.blank ? '_blank' : undefined}
              rel={c.blank ? 'noopener' : undefined}
            >
              <span class="inline-block animate-[floaty_5s_ease-in-out_infinite] text-[2rem]">{c.i}</span>
              <b class="my-2 block font-ft text-ink">{c.t}</b>
              <small class="block leading-[1.5] text-ink2" set:html={c.s} />
            </a>
          ) : (
            <div
              class="rounded-[18px] border-2 border-l-[6px] border-line bg-white p-5 text-center text-ink shadow-[0_6px_16px_rgba(90,42,156,.07)]"
              style={`border-left-color:${c.c}`}
            >
              <span class="inline-block animate-[floaty_5s_ease-in-out_infinite] text-[2rem]">{c.i}</span>
              <b class="my-2 block font-ft text-ink">{c.t}</b>
              <small class="block leading-[1.5] text-ink2" set:html={c.s} />
            </div>
          )
        ))
      }
    </div>

    <div id="socialsRow" class="rv my-[26px] flex flex-wrap justify-center gap-2.5">
      {
        CONFIG.redes.map((r) => (
          <a href={r.u} target="_blank" rel="noopener" class="flex items-center gap-2 rounded-full border-[1.5px] border-line bg-white px-4 py-2.5 text-[.85rem] font-extrabold text-ink no-underline transition hover:border-ama hover:bg-ama hover:text-m800">
            {r.i} {r.n} · <span class="text-m500">{CONFIG.handle}</span>
          </a>
        ))
      }
      <a href={waLink('Hola!')} target="_blank" rel="noopener" class="flex items-center gap-2 rounded-full border-[1.5px] border-line bg-white px-4 py-2.5 text-[.85rem] font-extrabold text-ink no-underline transition hover:border-ama hover:bg-ama hover:text-m800">
        💬 WhatsApp · {CONFIG.waDisplay}
      </a>
    </div>

    <form class="cform rv mx-auto mt-[26px] grid max-w-[640px] gap-3 rounded-[22px] border-2 border-line bg-white p-6 text-ink shadow-[0_8px_20px_rgba(90,42,156,.08)]" id="cForm">
      <b class="font-ft text-[1.1rem]">✍️ Escríbenos y te respondemos por WhatsApp</b>
      <label for="cfNombre" class="text-[.8rem] font-extrabold text-ink2">Tu nombre</label>
      <input id="cfNombre" class="w-full rounded-xl border-2 border-line bg-[#f9f6ff] px-3.5 py-3 font-fb text-[.95rem] text-ink outline-none focus:border-m400" placeholder="Ej: Camila Rojas" required />
      <label for="cfCel" class="text-[.8rem] font-extrabold text-ink2">Tu celular</label>
      <input id="cfCel" class="w-full rounded-xl border-2 border-line bg-[#f9f6ff] px-3.5 py-3 font-fb text-[.95rem] text-ink outline-none focus:border-m400" placeholder="Ej: +56 9 1234 5678" required />
      <label for="cfMsg" class="text-[.8rem] font-extrabold text-ink2">Mensaje</label>
      <textarea id="cfMsg" rows="3" class="w-full rounded-xl border-2 border-line bg-[#f9f6ff] px-3.5 py-3 font-fb text-[.95rem] text-ink outline-none focus:border-m400" placeholder="Cuéntanos: ¿qué fiesta se viene? 🎉"></textarea>
      <button class="btn btn-wsp btn-lg" type="submit">Enviar por WhatsApp 💬</button>
    </form>
  </div>
</section>
