---
import { CATS_ACTIVE, PUBLICOS, OCASIONES } from '../data/products';
import { CONFIG, waLink } from '../data/site';

const waDrawer = waLink('¡Hola! 👋 Quiero cotizar el arriendo de disfraces para adultos en La Mágica Tienda ✨');
const sublink = 'block rounded-[10px] px-3.5 py-[11px] text-[#4a3c78] no-underline hover:bg-[#f3edff]';
---

<div
  id="drawer"
  class="fixed inset-0 z-[90] overflow-y-auto bg-white px-5 pb-10 pt-[18px] text-ink"
  role="dialog"
  aria-modal="true"
  aria-label="Menú"
>
  <div class="mb-3.5 flex items-center justify-between">
    <span class="font-ft font-bold text-ink">⭐ La Mágica Tienda</span>
    <button class="btn btn-ghost btn-sm" id="drawerClose">Cerrar ✕</button>
  </div>

  <div id="drawerNav">
    <details class="dacc">
      <summary class="flex cursor-pointer list-none items-center gap-2.5 border-b border-line px-1.5 py-3.5 font-ft text-[1.1rem] font-semibold text-ink [&::-webkit-details-marker]:hidden">
        🎭 Disfraces <span class="arr ml-auto text-m500 transition">›</span>
      </summary>
      <div class="sub">
        <details class="dacc">
          <summary class="flex cursor-pointer list-none items-center gap-2.5 border-b border-line px-1.5 py-3.5 font-ft text-[1.1rem] font-semibold text-ink [&::-webkit-details-marker]:hidden" style="font-size:.95rem">
            Temática <span class="arr ml-auto text-m500 transition">›</span>
          </summary>
          <div class="sub">
            {CATS_ACTIVE.map((c) => <a class={sublink} href="#catalogo" data-tem={c.id}>{c.i} {c.n}</a>)}
          </div>
        </details>
        <details class="dacc">
          <summary class="flex cursor-pointer list-none items-center gap-2.5 border-b border-line px-1.5 py-3.5 font-ft text-[1.1rem] font-semibold text-ink [&::-webkit-details-marker]:hidden" style="font-size:.95rem">
            Público (adultos) <span class="arr ml-auto text-m500 transition">›</span>
          </summary>
          <div class="sub">
            {PUBLICOS.map((p) => <a class={sublink} href="#catalogo" data-pub={p.id}>{p.i} {p.n}</a>)}
          </div>
        </details>
        <details class="dacc">
          <summary class="flex cursor-pointer list-none items-center gap-2.5 border-b border-line px-1.5 py-3.5 font-ft text-[1.1rem] font-semibold text-ink [&::-webkit-details-marker]:hidden" style="font-size:.95rem">
            Celebración <span class="arr ml-auto text-m500 transition">›</span>
          </summary>
          <div class="sub">
            {OCASIONES.slice(0, 6).map((o) => <a class={sublink} href="#catalogo" data-oca={o.id}>{o.i} {o.n}</a>)}
          </div>
        </details>
      </div>
    </details>

    <a class="big flex items-center gap-2.5 border-b border-line px-1.5 py-3.5 font-ft text-[1.1rem] font-semibold text-ink no-underline" href="#promos">🎈 Promos</a>
    <a class="big flex items-center gap-2.5 border-b border-line px-1.5 py-3.5 font-ft text-[1.1rem] font-semibold text-ink no-underline" href="#fechas">📆 Fechas</a>
    <a class="big flex items-center gap-2.5 border-b border-line px-1.5 py-3.5 font-ft text-[1.1rem] font-semibold text-ink no-underline" href="#como">🪄 Cómo funciona</a>

    <details class="dacc">
      <summary class="flex cursor-pointer list-none items-center gap-2.5 border-b border-line px-1.5 py-3.5 font-ft text-[1.1rem] font-semibold text-ink [&::-webkit-details-marker]:hidden">
        ➕ Más <span class="arr ml-auto text-m500 transition">›</span>
      </summary>
      <div class="sub">
        <a class={sublink} href="#pagos">💳 Medios de pago</a>
        <a class={sublink} href="#" data-opencond>🛡️ Condiciones de arriendo</a>
        <a class={sublink} href="#mapa">📍 Cómo llegar</a>
        <a class={sublink} href="#faq">❓ Preguntas frecuentes</a>
        <a class={sublink} href="#contacto">📞 Contacto</a>
      </div>
    </details>
  </div>

  <div class="mt-[22px] flex flex-col gap-3">
    <button class="btn btn-ama btn-lg" id="drawerReq">🛒 Tu arriendo</button>
    <a class="btn btn-wsp btn-lg" href={waDrawer} target="_blank" rel="noopener">💬 Cotizar por WhatsApp</a>
    <div class="flex justify-center gap-2 text-[1.3rem]">
      {
        CONFIG.redes.map((r) => (
          <a class="grid h-[42px] w-[42px] place-items-center rounded-full bg-[#f0eaff] text-[1.15rem] no-underline" href={r.u} target="_blank" rel="noopener" aria-label={r.n}>
            {r.i}
          </a>
        ))
      }
    </div>
  </div>
</div>
