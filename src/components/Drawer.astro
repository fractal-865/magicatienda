---
import { CATS_ACTIVE, PUBLICOS, OCASIONES } from '../data/products';
import { CONFIG, waLink, ir } from '../data/site';

/* En la página del catálogo los enlaces a secciones vuelven a la portada. */
const { pagina = 'inicio' } = Astro.props as { pagina?: 'inicio' | 'catalogo' };
const enCat = pagina === 'catalogo';
const sec = (h: string) => (enCat ? ir(`/${h}`) : h);
const urlCat = enCat ? '#catalogo' : ir('/catalogo/');

const waDrawer = waLink('¡Hola! Quiero cotizar el arriendo de disfraces para adultos en La Mágica Tienda.');
const sublink = 'block rounded-[10px] px-3.5 py-[11px] text-[#4a3c78] no-underline hover:bg-[#f3edff]';

/* Nombres abreviados: máximo 2 palabras */
const CORTOS: Record<string, string> = {
  'Películas y series': 'Películas',
  'Anime y videojuegos': 'Anime',
  'Princesas y cuentos': 'Princesas',
  'Épocas e históricos': 'Épocas',
  'Halloween y terror': 'Halloween',
  'Fiesta temática': 'Fiesta',
  'Despedida de solter@': 'Despedida',
};
const corto = (s: string) => CORTOS[s] ?? s;
---

<div
  id="drawer"
  class="fixed inset-0 z-[90] overflow-y-auto bg-white px-5 pb-10 pt-[18px] text-ink"
  role="dialog"
  aria-modal="true"
  aria-label="Menú"
  inert
>
  <div class="mb-3.5 flex items-center justify-between">
    <img
      class="drawer-logo"
      src={`${import.meta.env.BASE_URL}/img/logo.png`.replace(/\/{2,}/g, '/')}
      alt="La Mágica Tienda de Disfraces"
      width="380"
      height="300"
    />
    <button class="btn btn-ghost btn-sm" id="drawerClose">Cerrar ✕</button>
  </div>

  <div id="drawerNav">
    <details class="dacc">
      <summary class="flex cursor-pointer list-none items-center gap-2.5 border-b border-line px-1.5 py-3.5 font-ft text-[1.1rem] font-semibold text-ink [&::-webkit-details-marker]:hidden">
        🎭 Catálogo <span class="arr ml-auto text-m500 transition">›</span>
      </summary>
      <div class="sub">
        <details class="dacc">
          <summary class="flex cursor-pointer list-none items-center gap-2.5 border-b border-line px-1.5 py-3.5 font-ft text-[1.1rem] font-semibold text-ink [&::-webkit-details-marker]:hidden" style="font-size:.95rem">
            Temática <span class="arr ml-auto text-m500 transition">›</span>
          </summary>
          <div class="sub">
            {CATS_ACTIVE.map((c) => <a class={sublink} href="#catalogo" data-tem={c.id}>{c.i} {corto(c.n)}</a>)}
          </div>
        </details>
        <details class="dacc">
          <summary class="flex cursor-pointer list-none items-center gap-2.5 border-b border-line px-1.5 py-3.5 font-ft text-[1.1rem] font-semibold text-ink [&::-webkit-details-marker]:hidden" style="font-size:.95rem">
            Público <span class="arr ml-auto text-m500 transition">›</span>
          </summary>
          <div class="sub">
            {PUBLICOS.map((p) => <a class={sublink} href="#catalogo" data-pub={p.id}>{p.i} {p.n}</a>)}
          </div>
        </details>
        <details class="dacc">
          <summary class="flex cursor-pointer list-none items-center gap-2.5 border-b border-line px-1.5 py-3.5 font-ft text-[1.1rem] font-semibold text-ink [&::-webkit-details-marker]:hidden" style="font-size:.95rem">
            Celebración <span class="arr ml-auto text-m500 transition">›</span>
          </summary>
          <div class="sub">
            {OCASIONES.slice(0, 6).map((o) => <a class={sublink} href="#catalogo" data-oca={o.id}>{o.i} {corto(o.n)}</a>)}
          </div>
        </details>
      </div>
    </details>

    <a class="big flex items-center gap-2.5 border-b border-line px-1.5 py-3.5 font-ft text-[1.1rem] font-semibold text-ink no-underline" href={urlCat}>🪄 Catálogo completo</a>
    <a class="big flex items-center gap-2.5 border-b border-line px-1.5 py-3.5 font-ft text-[1.1rem] font-semibold text-ink no-underline" href={sec('#tarifas')}>💸 Tarifas</a>
    <a class="big flex items-center gap-2.5 border-b border-line px-1.5 py-3.5 font-ft text-[1.1rem] font-semibold text-ink no-underline" href={sec('#promos')}>🎈 Promos</a>
    <a class="big flex items-center gap-2.5 border-b border-line px-1.5 py-3.5 font-ft text-[1.1rem] font-semibold text-ink no-underline" href={sec('#fechas')}>📆 Fechas</a>
    <a class="big flex items-center gap-2.5 border-b border-line px-1.5 py-3.5 font-ft text-[1.1rem] font-semibold text-ink no-underline" href={sec('#como')}>🪄 Cómo funciona</a>

    <details class="dacc">
      <summary class="flex cursor-pointer list-none items-center gap-2.5 border-b border-line px-1.5 py-3.5 font-ft text-[1.1rem] font-semibold text-ink [&::-webkit-details-marker]:hidden">
        ➕ Más <span class="arr ml-auto text-m500 transition">›</span>
      </summary>
      <div class="sub">
        <a class={sublink} href={sec('#pagos')}>💳 Pagos</a>
        <a class={sublink} href="#" data-opencond>🛡️ Condiciones</a>
        <a class={sublink} href={sec('#mapa')}>📍 Cómo llegar</a>
        <a class={sublink} href={sec('#faq')}>❓ Preguntas</a>
        <a class={sublink} href={sec('#contacto')}>📞 Contacto</a>
      </div>
    </details>
  </div>

  <div class="mt-[22px] flex flex-col gap-3">
    <button class="btn btn-ama btn-lg" id="drawerReq">🛒 Tu arriendo</button>
    <a class="btn btn-wsp btn-lg" href={waDrawer} target="_blank" rel="noopener">💬 Cotizar por WhatsApp</a>
    <div class="flex justify-center gap-2 text-[1.3rem]">
      {
        CONFIG.redes.map((r) => (
          <a class="grid h-[42px] w-[42px] place-items-center rounded-full bg-[#f0eaff] text-[1.15rem] no-underline" href={r.u} target="_blank" rel="noopener" aria-label={r.n}>
            {r.i}
          </a>
        ))
      }
    </div>
  </div>
</div>
