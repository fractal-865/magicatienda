---
/* Barra superior: mensajes rotativos + cupón + WhatsApp */
---

<div
  class="relative z-10 flex flex-wrap items-center gap-2.5 border-b border-line bg-lav2 px-3.5 py-2 text-[.8rem]"
  role="status"
>
  <span id="topbarMsg" class="min-w-0 flex-1 basis-56 font-bold text-[#4a3c78] transition-all duration-[400ms]">
    🛡️ Garantía de $13.000 a $20.000 según el disfraz: se paga al retirar y se devuelve.
  </span>
  <div class="ml-auto flex items-center gap-2">
    <button
      id="couponBtn"
      class="couponbtn"
      data-tip="Copia el código y lo aplicamos a tu cotización"
      aria-label="Copiar y aplicar cupón MAGIA15, 15 por ciento de descuento"
    >
      <span class="shim" aria-hidden="true"></span>
      <span id="cpnIco">🎟️</span>
      <span id="cpnTxt">Cupón 15% dto.</span>
    </button>
    <a class="btn btn-wsp btn-sm" id="topWA" target="_blank" rel="noopener" href="#">💬 WhatsApp</a>
  </div>
</div>
