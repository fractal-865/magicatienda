---
import { waLink } from '../data/site';

const waChat = waLink('¡Hola! Quiero cotizar el arriendo de disfraces para adultos en La Mágica Tienda.');
---

<!-- Barra pegajosa de arriendo -->
<div
  id="stickyBar"
  class="fixed bottom-5 left-2.5 right-[86px] z-[84] items-center gap-2.5 rounded-2xl border-2 border-ama bg-white px-3.5 py-2.5 text-[.85rem] font-extrabold text-ink shadow-sh2"
>
  <span id="stickyTxt"></span>
  <button class="btn btn-wsp ml-auto px-3 py-2 text-[.8rem]" id="stickySend">Cotizar 💬</button>
</div>

<!-- Flotante de WhatsApp -->
<div id="wspZone" class="fixed bottom-5 right-3.5 z-[88] flex flex-col items-end gap-2.5">
  <button
    id="wspFloat"
    class="relative grid h-[54px] w-[54px] cursor-pointer place-items-center rounded-full border-0 bg-[linear-gradient(135deg,#2ecb6e,#128f4a)] text-white shadow-[0_10px_26px_rgba(37,211,102,.4)]"
    aria-label="Abrir chat de WhatsApp"
  >
    <svg viewBox="0 0 24 24" class="h-[27px] w-[27px]" fill="currentColor" aria-hidden="true">
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
      ></path>
    </svg>
    <span class="wsp-on absolute right-1.5 top-1.5 h-2.5 w-2.5 rounded-full bg-[#b7ffd2]" aria-hidden="true"></span>
  </button>
</div>

<!-- Chat de WhatsApp -->
<div
  id="wspChat"
  class="fixed right-3.5 bottom-[150px] z-[89] w-[min(330px,92vw)] overflow-hidden rounded-[20px_20px_6px_20px] bg-white text-ink shadow-[0_20px_50px_rgba(60,20,120,.35)] min-[900px]:bottom-24"
  role="dialog"
  aria-label="Chat de WhatsApp"
>
  <div class="flex items-center gap-2.5 bg-m700 px-4 py-3.5 text-white">
    <span class="grid h-10 w-10 place-items-center rounded-full bg-ama text-[1.3rem]">🎭</span>
    <div>
      <b class="font-ft">La Mágica Tienda</b><br />
      <small class="text-[#9ff0bb]">● en línea</small>
    </div>
    <button class="ml-auto cursor-pointer border-0 bg-transparent text-[1.1rem] text-white" id="waChatClose" aria-label="Cerrar chat">✕</button>
  </div>
  <div class="bg-mist p-3.5">
    <div class="mb-2.5 rounded-[12px_12px_12px_4px] bg-white p-3 text-[.85rem] shadow-[0_2px_8px_rgba(0,0,0,.08)]">
      ¡Hola! 👋 Elige una opción y seguimos por WhatsApp 💬
    </div>
    <div class="grid gap-2" id="waQR">
      <a href={waChat} target="_blank" rel="noopener" class="rounded-xl border-[1.5px] border-[#17a152] bg-[#e7f9ee] p-3 text-[.83rem] font-extrabold text-[#0c6a3c] no-underline hover:bg-[#25D366] hover:text-white">💬 Cotizar un disfraz</a>
      <a href={waChat} target="_blank" rel="noopener" class="rounded-xl border-[1.5px] border-[#17a152] bg-[#e7f9ee] p-3 text-[.83rem] font-extrabold text-[#0c6a3c] no-underline hover:bg-[#25D366] hover:text-white">📏 Consultar mi talla</a>
      <a href={waChat} target="_blank" rel="noopener" class="rounded-xl border-[1.5px] border-[#17a152] bg-[#e7f9ee] p-3 text-[.83rem] font-extrabold text-[#0c6a3c] no-underline hover:bg-[#25D366] hover:text-white">📅 Reservar para una fecha</a>
    </div>
  </div>
</div>
