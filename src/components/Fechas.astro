---
import { FECHAS } from '../data/site';

const nextDate = (m: number, d: number) => {
  const n = new Date();
  let t = new Date(n.getFullYear(), m, d, 23, 59);
  if (t < n) t = new Date(n.getFullYear() + 1, m, d, 23, 59);
  return t;
};
const sorted = FECHAS.map((f) => ({ ...f, dt: nextDate(f.m, f.d) })).sort((a, b) => a.dt - b.dt);
---

<section id="fechas" class="relative px-4 py-[46px]">
  <div class="mx-auto max-w-[1220px]">
    <h2 class="sec rv">📆 Fechas importantes para disfrazarte</h2>
    <p class="sec-sub rv">Toca una fecha y te mostramos los disfraces perfectos para tu evento.</p>

    <div
      id="fechasRow"
      class="rv thin-scroll relative flex gap-3.5 overflow-x-auto px-1 pb-5 pt-4 [scroll-snap-type:x_mandatory]"
    >
      {
        sorted.map((f, k) => (
          <div
            class={`fecha relative z-[1] min-w-[215px] snap-center rounded-[18px] border-2 bg-white px-3.5 py-[18px] text-center transition hover:-translate-y-[5px] hover:shadow-sh ${
              k === 0 ? 'next border-ama bg-[linear-gradient(160deg,#fffbe8,#fff)] shadow-[0_0_24px_rgba(255,210,63,.45)]' : 'border-line'
            }`}
            style={`border-top:6px solid ${k === 0 ? '#FFD23F' : f.c}`}
          >
            <div class="text-[2.4rem]">{f.i}</div>
            <h3 class="mb-0.5 mt-1.5 text-[1rem] text-ink">{f.n}</h3>
            <div class="text-[.875rem] font-extrabold text-m600">{f.f}</div>
            {k === 0 && <div class="fcd mt-1 mb-2 font-ft text-[.875rem] font-bold text-[#0c7a56]" data-m={f.m} data-d={f.d}></div>}
            <p class="mb-2.5 mt-1.5 min-h-[2.4em] text-[.875rem] text-ink2">{f.fr}</p>
            <button class="btn btn-ama btn-sm" data-tem={f.tem}>Ver disfraces para esta fecha</button>
          </div>
        ))
      }
    </div>
  </div>
</section>
