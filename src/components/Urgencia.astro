---
/* Barra de urgencia: solo la cuenta regresiva al próximo evento.
   Antes también tenía un desplegable con las fechas; las mismas fechas están
   en la sección "Fechas importantes", así que el panel era repetido. */
import { FECHAS } from '../data/site';

const nextDate = (m: number, d: number) => {
  const n = new Date();
  let t = new Date(n.getFullYear(), m, d, 23, 59);
  if (t < n) t = new Date(n.getFullYear() + 1, m, d, 23, 59);
  return t;
};
const prox = FECHAS.map((f) => ({ ...f, dt: nextDate(f.m, f.d) })).sort((a, b) => a.dt - b.dt)[0];
---

<div id="urgencia" class="urgencia" data-m={prox.m} data-d={prox.d}>
  <div class="urg-bar mx-auto max-w-[1220px]">
    <span class="urg-next">
      <span class="urg-pulse" aria-hidden="true"></span>
      ⏰ Próximo evento: <b>{prox.i} {prox.n}</b> · faltan <b class="urg-cd" data-m={prox.m} data-d={prox.d}>…</b>
    </span>
  </div>
</div>
