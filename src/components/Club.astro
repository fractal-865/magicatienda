---
/* Newsletter / club mágico */
---

<section id="club" class="relative px-4 py-[46px]">
  <div class="mx-auto max-w-[1220px]">
    <div class="rv mx-auto max-w-[640px] rounded-3xl bg-[linear-gradient(120deg,var(--color-m600),var(--color-rosa))] px-6 py-[34px] text-center text-white shadow-sh2">
      <h2 class="text-[1.6rem]">🔮 Únete al club mágico</h2>
      <p class="mt-1.5 text-[#ffe3f1]">Ofertas secretas, lanzamientos y cupones exclusivos en tu correo.</p>
      <form id="nlForm" class="mt-4 flex flex-wrap justify-center gap-2.5">
        <input
          type="email"
          id="nlEmail"
          class="min-w-[200px] flex-1 rounded-full border-2 border-white/35 bg-white/15 px-[18px] py-3 font-fb text-white outline-none placeholder:text-[#ffd7ee]"
          placeholder="tu@correo.cl"
          required
          aria-label="Correo electrónico"
        />
        <button class="btn btn-ama" type="submit">Unirme ✨</button>
      </form>
      <p id="nlOk" class="mt-3 hidden font-extrabold">🎉 ¡Listo! Bienvenid@ al club (demo).</p>
    </div>
  </div>
</section>
