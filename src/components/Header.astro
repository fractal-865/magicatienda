---
import { CATS_ACTIVE, PUBLICOS, OCASIONES, PRODUCTS, thumbSrcset } from '../data/products';
import { ir, sec as secEnlace } from '../data/site';
import { Picture } from 'astro:assets';
import logoImg from '../assets/img/logo.png';

/* Los enlaces a las secciones solo son anclas internas en la portada. En el
   catálogo y en la ficha de un disfraz apuntan a la portada (ver `sec`). */
const { pagina = 'inicio' } = Astro.props as { pagina?: 'inicio' | 'catalogo' | 'disfraz' };
const enCat = pagina === 'catalogo';
const enDisfraz = pagina === 'disfraz';
const sec = (h: string) => secEnlace(h, pagina);
/* "Catálogo" lleva a la página del catálogo completo; ya estando ahí, a la
   sección de esta misma página. */
const urlCat = enCat ? '#catalogo' : ir('/catalogo/');

/* El logo es un botón en la portada (ahí el clic dispara la sorpresa del
   confeti) y un enlace al inicio en la página del catálogo, donde el clic
   tiene que llevar de vuelta. */
const LogoTag = (enCat || enDisfraz) ? 'a' : 'button';

const count = (id: string) => PRODUCTS.filter((p) => p.cats.includes(id)).length;
const destacados = [...PRODUCTS].sort((a, b) => a.pop - b.pop).slice(0, 3);

const nlink =
  'inline-flex cursor-pointer items-center gap-1.5 rounded-xl px-3 py-2 font-ft text-[.875rem] font-semibold text-white/90 transition hover:bg-white/10 hover:text-white';

/* En la portada el logo es un botón (dispara el truco del murciélago); en las
   demás páginas es un enlace. El logo en blanco se logra con filter. */
const logoClase = 'logo-img group-hover:scale-[1.03] brightness-0 invert';

/* Nombres abreviados para el mega menú: máximo 2 palabras */
const CORTOS: Record<string, string> = {
  'Películas y series': 'Películas',
  'Anime y videojuegos': 'Anime',
  'Princesas y cuentos': 'Princesas',
  'Épocas e históricos': 'Épocas',
  'Halloween y terror': 'Halloween',
  'Fiesta temática': 'Fiesta',
  'Despedida de solter@': 'Despedida',
};
const corto = (s: string) => CORTOS[s] ?? s;
---

<header
  id="header"
  class="sticky top-0 z-[60] border-b border-white/10 backdrop-blur-xl transition-all duration-300"
  style="background:linear-gradient(120deg,#1a0f2e 0%,#2b1a44 100%);box-shadow:0 8px 24px rgba(20,8,40,0.35)"
>
  <div class="mx-auto max-w-[1220px] px-4">
    <div class="hrow relative flex items-center gap-3 py-3 transition-all duration-300">
      <!-- Logo -->
      <LogoTag
        id="logoBtn"
        class="group relative flex shrink-0 cursor-pointer items-center border-0 bg-transparent p-0 text-left"
        href={(enCat || enDisfraz) ? ir('/') : undefined}
        aria-label={(enCat || enDisfraz) ? 'Volver al inicio' : 'Inicio, La Mágica Tienda de Disfraces'}
      >
        {/* Truco del logo: al pasar el mouse sale un murciélago volando por
            detrás del logo y titilan tres estrellitas. No ocupa lugar y sólo se
            ve mientras dura la animación. */}
        <span class="logo-truco" aria-hidden="true">
          <i class="lt-bat">🦇</i>
          <i class="lt-spark lt-s1">✨</i>
          <i class="lt-spark lt-s2">✨</i>
          <i class="lt-spark lt-s3">✨</i>
        </span>
<Picture
          class={logoClase}
          src={logoImg}
          alt="La Mágica Tienda de Disfraces"
          widths={[128, 256, 384]}
          sizes="200px"
          formats={['avif', 'webp']}
          decoding="async"
        />
      </LogoTag>

      <!-- Navegación: centrada respecto de la página -->
      <nav
        class="absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-1/2 items-center gap-0.5 lg:flex"
        aria-label="Navegación principal"
      >
        {enDisfraz ? (
          <a id="topHome" class={nlink} href={ir('/')} aria-label="Ir al inicio">🏠</a>
        ) : (
          <button id="topHome" class={nlink} aria-label="Ir al inicio">🏠</button>
        )}
        <!-- "Catálogo" abre la página del catálogo completo (donde están todos
             los disfraces) y, al pasar el mouse, despliega el menú de temáticas -->
        <a
          id="megaBtn"
          class={`${nlink} mega-trigger`}
          href={urlCat}
          data-navsec="catalogo"
          aria-expanded="false"
          aria-controls="megaMenu"
          aria-haspopup="true"
          >Catálogo<span class="mega-caret" aria-hidden="true">▾</span></a
        >
        <a class={nlink} href={sec('#tarifas')} data-navsec="tarifas">Tarifas</a>
        <a class={nlink} href={sec('#fechas')} data-navsec="fechas">Fechas</a>
        <a class={nlink} href={sec('#como')} data-navsec="como">Cómo funciona</a>
        <a class={nlink} href={sec('#contacto')} data-navsec="contacto">Contacto</a>
      </nav>

      <!-- CTA de disfraces. El buscador ya no vive acá: quedó dentro del mega
           menú (escritorio) y del cajón (móvil y tablet). -->
      <div class="ml-auto flex items-center gap-2">
        <a href={urlCat} class="cta-disfraz cta-disfraz-b cta-on-dark" aria-label="Ver los disfraces">
          <span class="cta-ico" aria-hidden="true">🎭</span>
          <span class="cta-label">Disfraces</span>
        </a>
      </div>

      <!-- Menú y carrito juntos, alineados a la derecha -->
      <div class="flex items-center gap-2">
        <button
          id="burger"
          class="grid h-11 w-11 cursor-pointer place-items-center rounded-2xl border-[1.5px] border-white/20 bg-white/10 text-white min-[1024px]:hidden transition hover:bg-white/20"
          aria-label="Abrir menú"
          aria-expanded="false"
        >
          <span></span><span></span><span></span>
        </button>

        <div id="cartWrap" class="relative">
          <button
            id="cartBtn"
            class="relative grid h-11 w-11 cursor-pointer place-items-center rounded-2xl border-[1.5px] border-white/20 bg-white/10 text-[1.2rem] text-white transition hover:bg-white/20"
            aria-label="Tu arriendo, ver solicitud"
            aria-expanded="false"
          >
            <span aria-hidden="true">🛒</span
            ><span
              id="cartCount"
              aria-hidden="true"
              class="absolute -right-1.5 -top-1.5 grid h-5 min-w-5 place-items-center rounded-full bg-rosa px-1 text-[.75rem] font-extrabold text-white tabular-nums"
              >0</span
            >
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Mega menú (centrado, no ocupa todo el ancho) -->
  <div
    id="megaMenu"
    class="mega absolute left-1/2 top-full z-[80] grid w-[min(1020px,94vw)] -translate-x-1/2 grid-cols-[1.1fr_1fr_1fr_1.3fr] gap-6 rounded-b-3xl rounded-t-[10px] border-x border-b border-line bg-white px-6 pt-7 shadow-[0_24px_50px_rgba(90,42,156,.22)]"
    role="menu"
  >
    <span class="mega-arrow" aria-hidden="true"></span>
    <!-- Buscador: ahora vive acá. Escribe y Enter lleva al catálogo filtrado. -->
    <form
      class="mega-search col-span-full -mt-1 flex items-center gap-2"
      data-megasearch
      role="search"
    >
      <label class="sr-only" for="megaSearchInput">Buscar disfraz por nombre o código</label>
      <input
        id="megaSearchInput"
        type="search"
        class="w-full rounded-[12px] border-[1.5px] border-line bg-[#f9f6ff] px-3.5 py-2.5 text-[1rem] text-ink outline-none transition focus:border-m400"
        placeholder="Buscar disfraz por nombre o código…"
        autocomplete="off"
      />
      <button type="submit" class="btn btn-mora btn-sm shrink-0">Buscar</button>
    </form>
    <div>
      <p class="mb-2.5 font-ft text-[1rem] text-m600">🎭 Temática</p>
      <ul class="list-none">
        {
          CATS_ACTIVE.map((c) => (
            <li>
              <a role="menuitem" data-tem={c.id} href={urlCat} class="flex cursor-pointer items-center gap-2 rounded-[10px] px-2 py-[7px] text-[1rem] text-[#4a3c78] no-underline transition hover:translate-x-1 hover:bg-[#f3edff] hover:text-m600">
                {c.i} {corto(c.n)}
                <small class="ml-auto rounded-full bg-lav2 px-[7px] py-[2px] text-[.75rem] font-extrabold text-m600 tabular-nums">{count(c.id)}</small>
              </a>
            </li>
          ))
        }
      </ul>
      {
        !enCat && (
          <a
            href={ir('/catalogo/')}
            class="mt-2.5 flex items-center gap-2 rounded-[10px] bg-[#f3edff] px-2 py-[9px] text-[1rem] font-extrabold text-m600 no-underline transition hover:translate-x-1 hover:bg-[#e6d9ff]"
          >
            🪄 Ver todo el catálogo ({PRODUCTS.length})
          </a>
        )
      }
    </div>

    <div>
      <p class="mb-2.5 font-ft text-[1rem] text-m600">🧑 Público</p>
      <ul class="list-none">
        {
          PUBLICOS.map((p) => (
            <li>
              <a role="menuitem" data-pub={p.id} href={urlCat} class="flex cursor-pointer items-center gap-2 rounded-[10px] px-2 py-[7px] text-[1rem] text-[#4a3c78] no-underline transition hover:translate-x-1 hover:bg-[#f3edff] hover:text-m600">
                {p.i} {p.n}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="mb-2.5 font-ft text-[1rem] text-m600">🎉 Celebración</p>
      <ul class="list-none">
        {
          OCASIONES.slice(0, 6).map((o) => (
            <li>
              <a role="menuitem" data-oca={o.id} href={urlCat} class="flex cursor-pointer items-center gap-2 rounded-[10px] px-2 py-[7px] text-[1rem] text-[#4a3c78] no-underline transition hover:translate-x-1 hover:bg-[#f3edff] hover:text-m600">
                {o.i} {corto(o.n)}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-3 border-t border-dashed border-line pt-2.5">
        <a href="#" data-opencond class="flex items-center gap-2 rounded-[10px] px-2 py-1.5 text-[.875rem] font-extrabold text-m500 no-underline hover:bg-[#f3edff]">🛡️ Condiciones →</a>
      </div>
    </div>

    <div class="relative flex min-h-[220px] flex-col justify-center gap-2 overflow-hidden rounded-[18px] bg-[linear-gradient(140deg,var(--color-rosa),var(--color-m600))] p-[18px] text-white">
      <span class="text-[2rem]">📍</span>
      <b class="font-ft text-[length:var(--text-subhead)] [text-shadow:0_2px_8px_rgba(0,0,0,.4)]">Cómo llegar</b>
      <span class="text-[1rem]">Hermann Wiegartt 01194, a pasos del Mall Pionero en Punta Arenas.</span>
      <button class="btn btn-ama btn-sm w-fit" data-mgo="mapa">Ver el mapa 🗺️</button>
    </div>

    <div class="thin-scroll col-span-full flex items-center gap-3.5 overflow-x-auto border-t border-line pb-[18px] pt-3.5">
      <span class="whitespace-nowrap font-ft text-[.875rem] text-m600">🔥 Destacados del catálogo:</span>
      <span class="flex gap-2.5">
        {
          destacados.map((c) => (
            <button data-qv={c.id} class="ms-card flex cursor-pointer items-center gap-2.5 whitespace-nowrap rounded-[14px] border-[1.5px] border-line bg-[#f7f2ff] px-3.5 py-2 pl-2 text-ink transition hover:-translate-y-0.5 hover:border-ama">
              <img src={c.img} srcset={thumbSrcset(c.img)} sizes="44px" data-full={c.img} onerror="this.onerror=null;this.removeAttribute('srcset');this.src=this.dataset.full" alt="" class="h-11 w-11 rounded-[10px] bg-[#efe8ff] object-cover" loading="lazy" decoding="async" width="44" height="44" />
              <span class="text-left text-[.875rem]">{c.n}<br /><b class="text-[.875rem] text-m600">Tallas {c.tl.join(' · ')}</b></span>
            </button>
          ))
        }
      </span>
    </div>
  </div>
</header>

<!-- Panel lateral del carrito (deslizable) + fondo -->
<div id="cartBackdrop" class="cart-backdrop" aria-hidden="true"></div>
<aside id="miniCart" class="minicart" aria-label="Tu arriendo" aria-live="polite" inert></aside>
