---
import { CATS_ACTIVE, PUBLICOS, OCASIONES, PRODUCTS } from '../data/products';
import { ir } from '../data/site';

/* En la página del catálogo los enlaces a secciones vuelven a la portada; en la
   portada siguen siendo anclas internas, como siempre. */
const { pagina = 'inicio' } = Astro.props as { pagina?: 'inicio' | 'catalogo' };
const enCat = pagina === 'catalogo';
const sec = (h: string) => (enCat ? ir(`/${h}`) : h);
/* "Catálogo" lleva a la página del catálogo completo; ya estando ahí, a la
   sección de esta misma página. */
const urlCat = enCat ? '#catalogo' : ir('/catalogo/');

/* El logo es un botón en la portada (ahí el clic dispara la sorpresa del
   confeti) y un enlace al inicio en la página del catálogo, donde el clic
   tiene que llevar de vuelta. */
const LogoTag = enCat ? 'a' : 'button';

const count = (id: string) => PRODUCTS.filter((p) => p.cats.includes(id)).length;
const destacados = [...PRODUCTS].sort((a, b) => a.pop - b.pop).slice(0, 3);

const nlink =
  'inline-flex cursor-pointer items-center gap-1.5 rounded-xl px-3 py-2 font-ft text-[.92rem] font-semibold text-ink transition hover:bg-[#f0eaff] hover:text-m600';

/* Nombres abreviados para el mega menú: máximo 2 palabras */
const CORTOS: Record<string, string> = {
  'Películas y series': 'Películas',
  'Anime y videojuegos': 'Anime',
  'Princesas y cuentos': 'Princesas',
  'Épocas e históricos': 'Épocas',
  'Halloween y terror': 'Halloween',
  'Fiesta temática': 'Fiesta',
  'Despedida de solter@': 'Despedida',
};
const corto = (s: string) => CORTOS[s] ?? s;
---

<header
  id="header"
  class="sticky top-0 z-[60] border-b border-line/50 bg-white/80 backdrop-blur-xl transition-all duration-300"
>
  <div class="mx-auto max-w-[1220px] px-4">
    <div class="hrow flex items-center gap-3 py-3 transition-all duration-300">
      <!-- Logo -->
      <LogoTag
        id="logoBtn"
        class="group flex shrink-0 cursor-pointer items-center border-0 bg-transparent p-0 text-left"
        href={enCat ? ir('/') : undefined}
        aria-label={enCat ? 'Volver al inicio' : 'Inicio, La Mágica Tienda de Disfraces'}
      >
        <img
          class="logo-img group-hover:scale-[1.03]"
          src={`${import.meta.env.BASE_URL}/img/logo.png`.replace(/\/{2,}/g, '/')}
          alt="La Mágica Tienda de Disfraces"
          width="380"
          height="300"
          decoding="async"
        />
      </LogoTag>

      <!-- Navegación -->
      <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Navegación principal">
        <button id="topHome" class={nlink} aria-label="Ir al inicio">🏠</button>
        <!-- "Catálogo" abre la página del catálogo completo (donde están todos
             los disfraces) y, al pasar el mouse, despliega el menú de temáticas -->
        <a
          id="megaBtn"
          class={`${nlink} mega-trigger`}
          href={urlCat}
          data-navsec="catalogo"
          aria-expanded="false"
          aria-controls="megaMenu"
          aria-haspopup="true"
          >Catálogo<span class="mega-caret" aria-hidden="true">▾</span></a
        >
        <a class={nlink} href={sec('#tarifas')} data-navsec="tarifas">Tarifas</a>
        <a class={nlink} href={sec('#fechas')} data-navsec="fechas">Fechas</a>
        <a class={nlink} href={sec('#como')} data-navsec="como">Cómo funciona</a>
        <a class={nlink} href={sec('#contacto')} data-navsec="contacto">Contacto</a>
      </nav>

      <!-- Buscador: un solo botón que lleva al buscador del catálogo -->
      <div class="ml-auto">
        <button id="searchToggle" class="searchToggle" aria-label="Ir al buscador del catálogo">🔍</button>
      </div>

      <!-- Menú y carrito juntos, alineados a la derecha -->
      <div class="flex items-center gap-2">
        <button
          id="burger"
          class="grid h-11 w-11 cursor-pointer place-items-center rounded-2xl border-[1.5px] border-line bg-[#f4eeff] min-[1024px]:hidden"
          aria-label="Abrir menú"
          aria-expanded="false"
        >
          <span></span><span></span><span></span>
        </button>

        <div id="cartWrap" class="relative">
          <button
            id="cartBtn"
            class="relative grid h-11 w-11 cursor-pointer place-items-center rounded-2xl border-[1.5px] border-line bg-[#f4eeff] text-[1.2rem] transition hover:bg-[#e6d9ff]"
            aria-label="Tu arriendo, ver cotización"
            aria-expanded="false"
          >
            🛒<span
              id="cartCount"
              class="absolute -right-1.5 -top-1.5 grid h-5 min-w-5 place-items-center rounded-full bg-rosa px-1 text-[.66rem] font-extrabold text-white"
              >0</span
            >
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Mega menú (centrado, no ocupa todo el ancho) -->
  <div
    id="megaMenu"
    class="mega absolute left-1/2 top-full z-[80] grid w-[min(1020px,94vw)] -translate-x-1/2 grid-cols-[1.1fr_1fr_1fr_1.3fr] gap-6 rounded-b-3xl rounded-t-[10px] border-x border-b border-line bg-white px-6 pt-7 shadow-[0_24px_50px_rgba(90,42,156,.22)]"
    role="menu"
  >
    <span class="mega-arrow" aria-hidden="true"></span>
    <div>
      <p class="mb-2.5 font-ft text-[.95rem] text-m600">🎭 Temática</p>
      <ul class="list-none">
        {
          CATS_ACTIVE.map((c) => (
            <li>
              <a role="menuitem" data-tem={c.id} href="#catalogo" class="flex cursor-pointer items-center gap-2 rounded-[10px] px-2 py-[7px] text-[.9rem] text-[#4a3c78] no-underline transition hover:translate-x-1 hover:bg-[#f3edff] hover:text-m600">
                {c.i} {corto(c.n)}
                <small class="ml-auto rounded-full bg-[#e2f7ec] px-[7px] py-[2px] text-[.68rem] font-extrabold text-[#0c7a56]">{count(c.id)}</small>
              </a>
            </li>
          ))
        }
      </ul>
      {
        !enCat && (
          <a
            href={ir('/catalogo/')}
            class="mt-2.5 flex items-center gap-2 rounded-[10px] bg-[#f3edff] px-2 py-[9px] text-[.9rem] font-extrabold text-m600 no-underline transition hover:translate-x-1 hover:bg-[#e6d9ff]"
          >
            🪄 Ver todo el catálogo ({PRODUCTS.length})
          </a>
        )
      }
    </div>

    <div>
      <p class="mb-2.5 font-ft text-[.95rem] text-m600">🧑 Público</p>
      <ul class="list-none">
        {
          PUBLICOS.map((p) => (
            <li>
              <a role="menuitem" data-pub={p.id} href="#catalogo" class="flex cursor-pointer items-center gap-2 rounded-[10px] px-2 py-[7px] text-[.9rem] text-[#4a3c78] no-underline transition hover:translate-x-1 hover:bg-[#f3edff] hover:text-m600">
                {p.i} {p.n}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="mb-2.5 font-ft text-[.95rem] text-m600">🎉 Celebración</p>
      <ul class="list-none">
        {
          OCASIONES.slice(0, 6).map((o) => (
            <li>
              <a role="menuitem" data-oca={o.id} href="#catalogo" class="flex cursor-pointer items-center gap-2 rounded-[10px] px-2 py-[7px] text-[.9rem] text-[#4a3c78] no-underline transition hover:translate-x-1 hover:bg-[#f3edff] hover:text-m600">
                {o.i} {corto(o.n)}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-3 border-t border-dashed border-line pt-2.5">
        <a href="#" data-opencond class="flex items-center gap-2 rounded-[10px] px-2 py-1.5 text-[.88rem] font-extrabold text-m500 no-underline hover:bg-[#f3edff]">🛡️ Condiciones →</a>
      </div>
    </div>

    <div class="relative flex min-h-[220px] flex-col justify-center gap-2 overflow-hidden rounded-[18px] bg-[linear-gradient(140deg,var(--color-rosa),var(--color-m600))] p-[18px] text-white">
      <span class="text-[2rem]">📍</span>
      <b class="font-ft text-[1.25rem] [text-shadow:0_2px_8px_rgba(0,0,0,.4)]">Cómo llegar</b>
      <span class="text-[.95rem]">Hermann Wiegartt 01194, a pasos del Mall Pionero en Punta Arenas.</span>
      <button class="btn btn-ama btn-sm w-fit" data-mgo="mapa">Ver el mapa 🗺️</button>
    </div>

    <div class="thin-scroll col-span-full flex items-center gap-3.5 overflow-x-auto border-t border-line pb-[18px] pt-3.5">
      <span class="whitespace-nowrap font-ft text-[.85rem] text-m600">🔥 Destacados del catálogo:</span>
      <span class="flex gap-2.5">
        {
          destacados.map((c) => (
            <button data-qv={c.id} class="ms-card flex cursor-pointer items-center gap-2.5 whitespace-nowrap rounded-[14px] border-[1.5px] border-line bg-[#f7f2ff] px-3.5 py-2 pl-2 text-ink transition hover:-translate-y-0.5 hover:border-ama">
              <img src={c.img} alt="" class="h-11 w-11 rounded-[10px] bg-[#efe8ff] object-cover" loading="lazy" />
              <span class="text-left text-[.8rem]">{c.n}<br /><b class="text-[.75rem] text-m600">Tallas {c.tl.join(' · ')}</b></span>
            </button>
          ))
        }
      </span>
    </div>
  </div>
</header>

<!-- Panel lateral del carrito (deslizable) + fondo -->
<div id="cartBackdrop" class="cart-backdrop" aria-hidden="true"></div>
<aside id="miniCart" class="minicart" aria-label="Tu arriendo" aria-live="polite" inert></aside>
