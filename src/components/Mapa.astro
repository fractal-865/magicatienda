---
import { CONFIG, waLink } from '../data/site';

const enc = encodeURIComponent(CONFIG.dir);
const maps = `https://www.google.com/maps/search/?api=1&query=${enc}`;
const embed = `https://www.google.com/maps?q=${enc}&output=embed`;
const waze = `https://www.waze.com/ul?q=${enc}&navigate=yes`;
const wa = waLink('¡Hola! ¿Me ayudan a llegar a la tienda?');
---

<section id="mapa" class="relative px-4 py-[46px]">
  <div class="mx-auto max-w-[1220px]">
    <h2 class="sec-sm rv">📍 Cómo llegar</h2>
    <p class="sec-sub rv">{CONFIG.dir}</p>

    <div class="grid gap-[22px] min-[960px]:grid-cols-[1.2fr_.8fr]">
      <div class="rv rounded-[22px] border-2 border-line bg-white p-3.5 shadow-[0_8px_20px_rgba(90,42,156,.08)]">
        <iframe
          src={embed}
          class="h-[380px] w-full rounded-[14px] border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Mapa de La Mágica Tienda en Punta Arenas"
        ></iframe>
      </div>

      <div class="rv">
        <span id="openBadge" class="inline-flex items-center gap-2 rounded-full px-3.5 py-[7px] text-[.875rem] font-extrabold">…</span>
        <span id="halloHours" class="hallo-hours" hidden>🎃 Del 15 al 31 de octubre: horario especial 12:00–20:30</span>
        <div class="my-3.5 flex flex-col gap-2.5">
          <div class="flex items-center gap-2.5 rounded-xl border-[1.5px] border-line bg-white px-3.5 py-2.5 text-[1rem]">
            🚌 <span><b>Micro:</b> Líneas con recorrido por el sector del Mall Pionero, a pocas cuadras.</span>
          </div>
          <div class="flex items-center gap-2.5 rounded-xl border-[1.5px] border-line bg-white px-3.5 py-2.5 text-[1rem]">
            🚗 <span><b>Auto:</b> Estacionamiento del Mall Pionero y en las calles aledañas.</span>
          </div>
          <div class="flex items-center gap-2.5 rounded-xl border-[1.5px] border-line bg-white px-3.5 py-2.5 text-[1rem]">
            🚶 <span><b>A pie:</b> Estamos cerca del Mall Pionero, sobre Hermann Wiegartt.</span>
          </div>
        </div>
        <div class="flex flex-wrap gap-2.5">
          <a class="btn btn-ama btn-sm" href={maps} target="_blank" rel="noopener">🗺️ Google Maps</a>
          <a class="btn btn-rosa btn-sm" href={waze} target="_blank" rel="noopener">🚘 Waze</a>
          <a class="btn btn-wsp btn-sm" href={wa} target="_blank" rel="noopener">💬 WhatsApp</a>
        </div>
      </div>
    </div>
  </div>
</section>
