---
import '../styles/global.css';
/* Fuentes locales (sin CDN externo): Fredoka, Nunito y Caveat */
import '@fontsource/fredoka/500.css';
import '@fontsource/fredoka/600.css';
import '@fontsource/fredoka/700.css';
import '@fontsource/nunito/400.css';
import '@fontsource/nunito/700.css';
import '@fontsource/nunito/800.css';
import '@fontsource/caveat/600.css';
import Header from '../components/Header.astro';
import Drawer from '../components/Drawer.astro';
import Footer from '../components/Footer.astro';
import Floaters from '../components/Floaters.astro';
import Modals from '../components/Modals.astro';
import { CONFIG, FAQS, SEO, url } from '../data/site';

/* ── Página actual ──
   La portada y el catálogo comparten el mismo armazón (menú, pie, modales).
   Cada página pasa su título, su descripción y su ruta; los valores por
   defecto son los de la portada, así que sin props el resultado es idéntico
   al de siempre. */
interface Props {
  /** <title> de la página */
  titulo?: string;
  /** Meta descripción */
  descripcion?: string;
  ogTitulo?: string;
  ogDescripcion?: string;
  /** Ruta canónica dentro del sitio, con barra final: '/catalogo/' */
  ruta?: string;
  /** En qué página estamos: ajusta los enlaces del menú, el cajón y el pie */
  pagina?: 'inicio' | 'catalogo';
  /** Nodos extra para el @graph (por ejemplo, las migas de pan) */
  esquema?: Record<string, unknown>[];
  /** Solo la portada tiene las preguntas frecuentes a la vista */
  conFaq?: boolean;
}
const {
  titulo = SEO.title,
  descripcion = SEO.description,
  ogTitulo = SEO.ogTitle,
  ogDescripcion = SEO.ogDescription,
  ruta = '/',
  pagina = 'inicio',
  esquema = [],
  conFaq = true,
} = Astro.props;

const canonical = url(ruta);
/* La ficha del negocio se ancla siempre a la portada: así el catálogo no parte
   la entidad en dos direcciones distintas. */
const raiz = url('/');
const ogImage = url('/img/logo-og.jpg');
const ogImageAlt = 'Logo de La Mágica Tienda de Disfraces, arriendo para adultos en Punta Arenas';

/* ── Datos para los buscadores (schema.org) ──
   Le dicen a Google que es una tienda local de Punta Arenas: nombre, dirección,
   teléfono, horario, redes y las preguntas frecuentes (esas pueden aparecer
   como resultado enriquecido). Todo se arma desde CONFIG y FAQS, así que si
   cambia un dato, cambia en un solo lugar. */
const datos = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['ClothingStore', 'LocalBusiness'],
      '@id': `${raiz}#tienda`,
      name: 'La Mágica Tienda de Disfraces',
      alternateName: 'La Mágica Tienda',
      description: SEO.description,
      url: raiz,
      image: ogImage,
      logo: url('/img/logo.png'),
      telephone: CONFIG.tel,
      email: CONFIG.email1,
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Hermann Wiegartt 01194',
        addressLocality: 'Punta Arenas',
        addressRegion: 'Magallanes',
        addressCountry: 'CL',
      },
      geo: { '@type': 'GeoCoordinates', latitude: SEO.geo.lat, longitude: SEO.geo.lng },
      hasMap: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(CONFIG.dir)}`,
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
          opens: '15:00',
          closes: '20:30',
        },
      ],
      priceRange: '$13.000–$20.000',
      currenciesAccepted: 'CLP',
      paymentAccepted: 'Efectivo, transferencia bancaria',
      areaServed: [
        { '@type': 'City', name: 'Punta Arenas' },
        { '@type': 'AdministrativeArea', name: 'Región de Magallanes' },
      ],
      sameAs: CONFIG.redes.map((r) => r.u),
      slogan: 'Arriendo de disfraces para adultos',
      makesOffer: {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Arriendo de disfraces para adultos por 3 días',
          serviceType: 'Arriendo de disfraces',
        },
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${raiz}#sitio`,
      url: raiz,
      name: 'La Mágica Tienda de Disfraces',
      description: SEO.description,
      inLanguage: 'es-CL',
      publisher: { '@id': `${raiz}#tienda` },
    },
    ...(conFaq
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${raiz}#faq`,
            mainEntity: FAQS.map(([q, a]) => ({
              '@type': 'Question',
              name: q,
              acceptedAnswer: { '@type': 'Answer', text: a },
            })),
          },
        ]
      : []),
    ...esquema,
  ],
};
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-cl" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <!-- Zona de la tienda: apoya las búsquedas "cerca de mí" en Magallanes -->
    <meta name="geo.region" content="CL-MA" />
    <meta name="geo.placename" content="Punta Arenas" />
    <meta name="geo.position" content={`${SEO.geo.lat};${SEO.geo.lng}`} />
    <meta name="ICBM" content={`${SEO.geo.lat}, ${SEO.geo.lng}`} />
    <link rel="icon" href={url('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/site.webmanifest')} />
    <meta name="theme-color" content="#5a2a9c" />
    <meta name="apple-mobile-web-app-title" content="La Mágica Tienda" />
    <meta name="application-name" content="La Mágica Tienda de Disfraces" />
    <!-- Al compartir el enlace (WhatsApp, Instagram, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="La Mágica Tienda de Disfraces" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={ogTitulo} />
    <meta property="og:description" content={ogDescripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitulo} />
    <meta name="twitter:description" content={ogDescripcion} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(datos)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="min-h-screen" {...pagina === 'catalogo' ? { 'data-page': 'catalogo' } : {}}>
    <a
      href="#catalogo"
      class="absolute -left-[999px] top-0 z-[200] rounded-br-xl bg-m600 px-4 py-2.5 font-extrabold text-white focus:left-0"
    >
      Ir al catálogo
    </a>

    <!-- Sprites SVG -->
    <svg style="display:none" aria-hidden="true">
      <symbol id="d-star" viewBox="0 0 64 64"><path d="M32 6l7 18 19 2-14 13 4 19-16-10-16 10 4-19L6 26l19-2z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/></symbol>
      <symbol id="d-hat" viewBox="0 0 64 64"><path d="M18 26v-12a4 4 0 0 1 4-4h20a4 4 0 0 1 4 4v12M10 30c14 6 30 6 44 0M18 26h28M26 16h12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></symbol>
      <symbol id="d-mask" viewBox="0 0 64 64"><path d="M8 26c8-6 40-6 48 0-2 12-10 20-24 20S10 38 8 26z" fill="none" stroke="currentColor" stroke-width="2.5"/><circle cx="22" cy="30" r="4" fill="none" stroke="currentColor" stroke-width="2.5"/><circle cx="42" cy="30" r="4" fill="none" stroke="currentColor" stroke-width="2.5"/></symbol>
      <symbol id="d-balloon" viewBox="0 0 64 64"><ellipse cx="32" cy="22" rx="13" ry="16" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M30 38l2 4 2-4M32 42c-4 8 4 10 0 18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></symbol>
      <symbol id="d-bow" viewBox="0 0 64 64"><path d="M30 32L12 22v20zM34 32l18-10v20zM28 28h8v8h-8z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/></symbol>
      <symbol id="d-bowler" viewBox="0 0 64 64"><path d="M16 34a16 14 0 0 1 32 0M8 38c16 6 32 6 48 0" fill="none" stroke="currentColor" stroke-width="2.5"/></symbol>
    </svg>

    <div id="doodles" aria-hidden="true"></div>

    <Header pagina={pagina} />
    <Drawer pagina={pagina} />

    <slot />

    <Footer pagina={pagina} />
    <Floaters />
    <Modals />

    <div id="toasts" class="pointer-events-none fixed bottom-[132px] left-1/2 z-[120] flex -translate-x-1/2 flex-col items-center gap-2 md:bottom-6">
    </div>
    <canvas id="confettiCanvas" class="pointer-events-none fixed inset-0 z-[130]" aria-hidden="true"></canvas>

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
