---
import Layout from '../../layouts/Layout.astro';
import { PRODUCTS, getDisfrazBySlug, getSimilares, clp, catById, displayTalla, TALLA_GUIA } from '../../data/products';
import { CONFIG, waLink, url, ir } from '../../data/site';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({
    params: { slug: `${p.id}-${p.n.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')}` },
    props: { product: p },
  }));
}

const { product: c } = Astro.props;
const T = catById(c.t);
const similares = getSimilares(c, 6);
const codigo = String(c.id).padStart(3, '0');
const slug = `${c.id}-${c.n.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')}`;
const pageUrl = url(`/disfraz/${slug}/`);
const waMsg = `¡Hola! Quiero cotizar el arriendo del disfraz ${c.n} (#${codigo}) para adultos. ¿Está disponible? ${pageUrl}`;
const waHref = waLink(waMsg);

const title = `${c.n} | Arriendo de disfraces en Punta Arenas`;
const description = `${c.d.slice(0, 150)}. Arriendo de disfraces en Punta Arenas.`;
const ogImage = url(c.img);
---

<Layout
  pagina="catalogo"
  titulo={title}
  descripcion={description}
  ogTitulo={title}
  ogDescripcion={description}
  ruta={`/disfraz/${slug}/`}
  conFaq={false}
>
  <main class="min-h-screen bg-[#faf8ff]">
    <!-- Breadcrumb -->
    <nav class="mx-auto max-w-[1220px] px-4 py-3 text-[.85rem] text-ink2" aria-label="Migas de pan">
      <a href={ir('/')} class="hover:text-m600">Inicio</a>
      <span class="mx-1.5 opacity-40">›</span>
      <a href={ir('/catalogo/')} class="hover:text-m600">Catálogo</a>
      <span class="mx-1.5 opacity-40">›</span>
      <span class="font-semibold text-ink">{c.n}</span>
    </nav>

    <!-- Ficha del disfraz -->
    <section class="mx-auto max-w-[1220px] px-4 pb-10">
      <div class="grid gap-8 min-[900px]:grid-cols-2">
        <!-- Imagen con zoom -->
        <div class="relative">
          <div class="zoom-container overflow-hidden rounded-3xl border-2 border-line bg-white shadow-sh cursor-zoom-in" id="zoomContainer" style="touch-action: none;">
            <img
              id="zoomImage"
              src={c.img}
              alt={`${c.n} para arriendo en Punta Arenas`}
              class="h-full w-full object-contain transition-transform duration-200 ease-out"
              loading="eager"
              width="600"
              height="900"
              draggable="false"
            />
          </div>
          <!-- Código badge -->
          <span class="absolute left-4 top-4 rounded-full bg-m600 px-3 py-1 text-[.75rem] font-extrabold text-white shadow-sh">
            Disfraz #{codigo}
          </span>
          <p class="mt-2 text-center text-[.75rem] text-ink2">🔍 Pasa el mouse o toca para hacer zoom</p>
        </div>

        <!-- Info -->
        <div class="flex flex-col gap-4">
          <div>
            <span class="text-[.75rem] font-extrabold uppercase tracking-[.05em] text-m500">{T.i} {T.n}</span>
            <h1 class="mt-1 font-ft text-[2rem] leading-tight text-ink min-[900px]:text-[2.4rem]">{c.n}</h1>
          </div>

          <p class="text-[.95rem] leading-[1.6] text-ink2">{c.d}</p>

          <!-- Categorías -->
          <div class="flex flex-wrap gap-2">
            {c.cats.map((catId) => {
              const cat = catById(catId);
              return (
                <a href={ir(`/catalogo/?cat=${catId}`)} class="rounded-full border-[1.5px] border-line bg-white px-3 py-1 text-[.75rem] font-bold text-m600 transition hover:border-m400 hover:bg-mist">
                  {cat.i} {cat.n}
                </a>
              );
            })}
          </div>

          <!-- Tallas -->
          <div id="tallasSection">
            <b class="block text-[.9rem] text-ink">📏 Tallas disponibles:</b>
            <div class="mt-2 flex flex-wrap gap-2">
              {c.tl.map((t) => (
                <span class="tip cursor-help rounded-lg bg-[#f0eaff] px-3 py-1.5 text-[.8rem] font-extrabold text-m600" data-tip={TALLA_GUIA[t] ? `Estatura recomendada: ${TALLA_GUIA[t]}` : 'Sin referencia de estatura'} tabindex="0">
                  {displayTalla(t)}
                </span>
              ))}
            </div>
            <p class="mt-1 text-[.75rem] text-ink2">
              {c.pub === 'mujer' ? '👩 Mujer' : c.pub === 'hombre' ? '👨 Hombre' : '🧑 Unisex'} · Solo adultos
            </p>
            <p class="mt-1 text-[.75rem] font-extrabold text-m500">
              Código: #{codigo}
            </p>
          </div>



          <!-- Valor -->
          <div class="rounded-2xl border-2 border-line bg-[#f9f6ff] p-4">
            <div class="flex items-baseline gap-2">
              <span class="font-ft text-[1.8rem] font-bold leading-none text-m600">Desde $15.000</span>
              <span class="text-[.8rem] font-bold text-ink2">arriendo por 3 días (retiro, uso y entrega)</span>
            </div>
            <p class="mt-1 text-[.75rem] text-ink2">El valor exacto se confirma en tu cotización por WhatsApp.</p>
          </div>

          <!-- Botón principal: Añadir al carrito -->
          <button
            type="button"
            class="btn btn-mora btn-lg w-full"
            id="addCartBtn"
            data-id={c.id}
          >
            🛒 Añadir al carrito
          </button>

          <!-- Acciones secundarias (más pequeñas) -->
          <div class="flex flex-wrap gap-2">
            <a
              href={waHref}
              target="_blank"
              rel="noopener"
              class="btn btn-wsp btn-sm flex items-center gap-1.5"
            >
              💬 Cotizar
            </a>
            <button
              type="button"
              class="btn btn-ghost btn-sm flex items-center gap-1.5"
              id="copyLinkBtn"
              data-url={pageUrl}
            >
              🔗 Copiar
            </button>
            <div class="relative">
              <button
                type="button"
                class="btn btn-ghost btn-sm flex items-center gap-1.5"
                id="shareBtn"
                aria-expanded="false"
                aria-haspopup="true"
              >
                📲 Compartir
              </button>
              <div
                id="shareMenu"
                class="absolute left-0 top-full z-50 mt-1 hidden min-w-[180px] rounded-xl border-2 border-line bg-white p-2 shadow-sh2"
              >
                <a
                  href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${c.n} — ${pageUrl}`)}`}
                  target="_blank"
                  rel="noopener"
                  class="flex items-center gap-2 rounded-lg px-3 py-2 text-[.85rem] font-bold text-ink transition hover:bg-mist"
                >
                  💬 WhatsApp
                </a>
                <a
                  href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`}
                  target="_blank"
                  rel="noopener"
                  class="flex items-center gap-2 rounded-lg px-3 py-2 text-[.85rem] font-bold text-ink transition hover:bg-mist"
                >
                  👍 Facebook
                </a>
                <a
                  href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(`${c.n}`)}&url=${encodeURIComponent(pageUrl)}`}
                  target="_blank"
                  rel="noopener"
                  class="flex items-center gap-2 rounded-lg px-3 py-2 text-[.85rem] font-bold text-ink transition hover:bg-mist"
                >
                  🐦 X (Twitter)
                </a>
              </div>
            </div>
          </div>

          <p class="text-[.75rem] text-ink2">
            Arriendo por 3 días: retiro, uso y entrega. Tallas S a XXL. Solo adultos.
          </p>
        </div>
      </div>
    </section>

    <!-- Disfraces similares -->
    {similares.length > 0 && (
      <section class="mx-auto max-w-[1220px] px-4 pb-12">
        <h2 class="sec-sm rv">🎭 Disfraces similares</h2>
        <p class="sec-sub rv">Otros disfraces que te pueden gustar</p>
        <div class="flex gap-3 overflow-x-auto pb-4 snap-x snap-mandatory scrollbar-hide" style="scrollbar-width: none; -ms-overflow-style: none;">
          {similares.map((s) => {
            const sSlug = `${s.id}-${s.n.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')}`;
            return (
              <a href={ir(`/disfraz/${sSlug}/`)} class="group block w-[160px] shrink-0 snap-start overflow-hidden rounded-2xl border-[1.5px] border-line bg-white shadow-sh transition hover:-translate-y-1 hover:shadow-sh2 min-[560px]:w-[200px]">
                <div class="relative aspect-[2/3] overflow-hidden bg-[#f0eaff]">
                  <img src={s.img} alt={s.n} class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105" loading="lazy" />
                  <span class="absolute left-2 top-2 rounded-full bg-m600/90 px-2 py-0.5 text-[.65rem] font-extrabold text-white">#{String(s.id).padStart(3, '0')}</span>
                </div>
                <div class="p-3">
                  <h3 class="text-[.9rem] font-semibold text-ink line-clamp-2">{s.n}</h3>
                  <span class="mt-1 block text-[.75rem] font-bold text-m500">{catById(s.t).i} {catById(s.t).n}</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </main>

  <script is:inline>
    // Zoom de imagen
    (function () {
      const container = document.getElementById('zoomContainer');
      const img = document.getElementById('zoomImage');
      if (!container || !img) return;

      const ZOOM = 2.5;
      let isZoomed = false;

      function setTransform(x, y) {
        img.style.transform = `scale(${ZOOM})`;
        img.style.transformOrigin = `${x}% ${y}%`;
      }

      function resetTransform() {
        img.style.transform = 'scale(1)';
        img.style.transformOrigin = 'center center';
      }

      // Desktop: mousemove
      container.addEventListener('mousemove', (e) => {
        const rect = container.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        setTransform(x, y);
      });
      container.addEventListener('mouseenter', () => {
        isZoomed = true;
        img.style.transition = 'transform 0.1s ease-out';
      });
      container.addEventListener('mouseleave', () => {
        isZoomed = false;
        img.style.transition = 'transform 0.3s ease-out';
        resetTransform();
      });

      // Mobile/Tablet: touch
      let touchActive = false;
      container.addEventListener('touchstart', (e) => {
        touchActive = true;
        img.style.transition = 'transform 0.1s ease-out';
        const touch = e.touches[0];
        const rect = container.getBoundingClientRect();
        const x = ((touch.clientX - rect.left) / rect.width) * 100;
        const y = ((touch.clientY - rect.top) / rect.height) * 100;
        setTransform(x, y);
      }, { passive: true });

      container.addEventListener('touchmove', (e) => {
        if (!touchActive) return;
        const touch = e.touches[0];
        const rect = container.getBoundingClientRect();
        const x = ((touch.clientX - rect.left) / rect.width) * 100;
        const y = ((touch.clientY - rect.top) / rect.height) * 100;
        setTransform(x, y);
      }, { passive: true });

      container.addEventListener('touchend', () => {
        touchActive = false;
        img.style.transition = 'transform 0.3s ease-out';
        resetTransform();
      });
    })();

    // Copiar enlace
    document.getElementById('copyLinkBtn')?.addEventListener('click', async function () {
      const url = this.dataset.url;
      try {
        await navigator.clipboard.writeText(url);
        this.textContent = '✅ Copiado';
        setTimeout(() => { this.textContent = '🔗 Copiar'; }, 2000);
      } catch {
        this.textContent = '❌ Error';
        setTimeout(() => { this.textContent = '🔗 Copiar'; }, 2000);
      }
    });

    // Menú de compartir
    const shareBtn = document.getElementById('shareBtn');
    const shareMenu = document.getElementById('shareMenu');
    shareBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = shareMenu?.classList.contains('hidden');
      shareMenu?.classList.toggle('hidden', !open);
      shareBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    document.addEventListener('click', (e) => {
      if (!shareMenu?.contains(e.target) && e.target !== shareBtn) {
        shareMenu?.classList.add('hidden');
        shareBtn?.setAttribute('aria-expanded', 'false');
      }
    });

    // Añadir al carrito
    let selectedTalla = '';
    const tallaSection = document.getElementById('tallasSection');
    const tallas = tallaSection?.querySelectorAll('.tip');
    tallas?.forEach((t) => {
      t.addEventListener('click', function () {
        selectedTalla = this.textContent.trim();
        tallas.forEach((x) => x.classList.remove('ring-2', 'ring-m600', 'bg-m600', 'text-white'));
        this.classList.add('ring-2', 'ring-m600', 'bg-m600', 'text-white');
      });
    });
    // Si solo hay una talla, seleccionarla automáticamente
    if (tallas && tallas.length === 1) {
      tallas[0].click();
    }

    document.getElementById('addCartBtn')?.addEventListener('click', function () {
      const id = Number(this.dataset.id);
      if (!selectedTalla && tallas && tallas.length > 0) {
        // Resaltar la sección de tallas
        if (tallaSection) {
          tallaSection.classList.add('ring-2', 'ring-[#c0392b]', 'ring-offset-2', 'rounded-xl', 'bg-[#fdecea]', 'p-3');
          tallaSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
          setTimeout(() => {
            tallaSection.classList.remove('ring-[#c0392b]', 'bg-[#fdecea]');
            tallaSection.classList.add('ring-[#0c7a56]', 'bg-[#e2f7ec]');
          }, 1500);
        }
        return;
      }
      const talla = selectedTalla || (tallas && tallas.length === 1 ? tallas[0].textContent.trim() : '');
      if (talla) {
        window.location.href = '/catalogo/?add=' + id + '&talla=' + encodeURIComponent(talla);
      } else {
        window.location.href = '/catalogo/?quick=' + id;
      }
    });
  </script>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Tooltip CSS-only para tallas */
  .tip {
    position: relative;
    cursor: help;
  }
  .tip:hover::after,
  .tip:focus::after {
    content: attr(data-tip);
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-bottom: 6px;
    padding: 6px 10px;
    border-radius: 8px;
    background: #2b0d5e;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    white-space: nowrap;
    z-index: 100;
    pointer-events: none;
  }
</style>
