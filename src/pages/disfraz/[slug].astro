---
import Layout from '../../layouts/Layout.astro';
import { PRODUCTS, disfrazSlug, getSimilares, catById, displayTalla, TALLA_GUIA } from '../../data/products';
import { waLink, url, ir, PRECIO_DESDE } from '../../data/site';

/* Los datos que usa el buscador de la cabecera. El slug viaja ya calculado:
   el navegador no vuelve a derivarlo (así no puede diferir del de la página). */
const disfracesJSON = JSON.stringify(PRODUCTS.map((p) => ({
  id: p.id,
  n: p.n,
  img: p.img,
  cat: catById(p.t).n,
  slug: disfrazSlug(p),
})));

/* El slug sale de disfrazSlug() (en data/products.ts) para que las páginas, el
   sitemap y los enlaces del buscador usen siempre la misma cadena. */
export function getStaticPaths() {
  return PRODUCTS.map((p) => ({
    params: { slug: disfrazSlug(p) },
    props: { product: p },
  }));
}

const { product: c } = Astro.props;
const T = catById(c.t);
const similares = getSimilares(c, 6);
const codigo = String(c.id).padStart(3, '0');
const slug = disfrazSlug(c);
const pageUrl = url(`/disfraz/${slug}/`);
const waMsg = `¡Hola! Quiero cotizar el arriendo del disfraz ${c.n} (#${codigo}) para adultos. ¿Está disponible? ${pageUrl}`;
const waHref = waLink(waMsg);
const waShare = `https://api.whatsapp.com/send?text=${encodeURIComponent(`${c.n} — ${pageUrl}`)}`;
const fbShare = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`;

const title = `${c.n} | Arriendo de disfraces en Punta Arenas`;

/* Meta descripción: el texto de la ficha se corta en un límite de palabra
   (nunca a mitad de palabra, como pasaba antes) y se le suma la frase de
   marca. Así Google no recorta la frase a la mitad. */
const description = (() => {
  const cola = ' Arriendo por 3 días en Punta Arenas.';
  const limpio = String(c.d).replace(/\s+/g, ' ').trim();
  const tope = 158 - cola.length;
  if (limpio.length <= tope) return limpio + cola;
  const corte = limpio.slice(0, tope);
  const espacio = corte.lastIndexOf(' ');
  const base = (espacio > 60 ? corte.slice(0, espacio) : corte).replace(/[\s.,;:]+$/, '');
  return `${base}…${cola}`;
})();

const ogImage = url(`/img/og/${c.id}.jpg`);
const ogImageAlt = `${c.n} en arriendo en Punta Arenas`;

/* ── Datos para Google (schema.org) ──
   Las migas de pan (así Google muestra "Inicio › Catálogo › Disfraz" en el
   resultado) y la ficha del producto. El precio declarado es el de referencia
   que se ve en la página, por 3 días; el valor final se confirma por WhatsApp. */
const esquema = [
  {
    '@type': 'BreadcrumbList',
    '@id': `${pageUrl}#migas`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: url('/') },
      { '@type': 'ListItem', position: 2, name: 'Catálogo', item: url('/catalogo/') },
      { '@type': 'ListItem', position: 3, name: c.n, item: pageUrl },
    ],
  },
  {
    '@type': 'Product',
    '@id': `${pageUrl}#producto`,
    name: c.n,
    description: c.d,
    image: [ogImage],
    url: pageUrl,
    sku: `DISF-${codigo}`,
    category: T.n,
    brand: { '@type': 'Brand', name: 'La Mágica Tienda de Disfraces' },
    audience: { '@type': 'PeopleAudience', suggestedMinAge: 18 },
    offers: {
      '@type': 'Offer',
      '@id': `${pageUrl}#oferta`,
      url: pageUrl,
      priceCurrency: 'CLP',
      price: PRECIO_DESDE,
      availability: 'https://schema.org/InStock',
      itemCondition: 'https://schema.org/UsedCondition',
      seller: { '@id': `${url('/')}#tienda` },
      priceSpecification: {
        '@type': 'PriceSpecification',
        price: PRECIO_DESDE,
        priceCurrency: 'CLP',
        description: 'Valor de referencia del arriendo por 3 días (retiro, uso y entrega). El valor final se confirma por WhatsApp.',
      },
    },
  },
];

/* La descripción se parte en dos párrafos (como en la maqueta) cortando
   después de la primera frase. Si no hay un corte claro, queda uno solo. */
const descParrafos = (() => {
  const t = String(c.d).trim();
  const m = t.match(/^([^.]{40,}?\.)\s+(.+)$/);
  return m ? [m[1], m[2]] : [t];
})();
---

<Layout
  pagina="disfraz"
  titulo={title}
  descripcion={description}
  ogTitulo={title}
  ogDescripcion={description}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  ruta={`/disfraz/${slug}/`}
  conFaq={false}
  esquema={esquema}
>
  <main class="min-h-screen bg-[#faf8ff]">
    <!-- Breadcrumb -->
    <nav class="mx-auto max-w-[1220px] px-4 py-3 text-[.85rem] text-ink2" aria-label="Migas de pan">
      <a href={ir('/')} class="hover:text-m600">Inicio</a>
      <span class="mx-1.5 opacity-40">›</span>
      <a href={ir('/catalogo/')} class="hover:text-m600">Catálogo</a>
      <span class="mx-1.5 opacity-40">›</span>
      <span class="font-semibold text-ink">{c.n}</span>
    </nav>

    <!-- Ficha del disfraz -->
    <section class="mx-auto max-w-[1220px] px-4 pb-10">
      <div class="grid gap-8 min-[900px]:grid-cols-2">
        <!-- Imagen con zoom -->
        <div class="relative">
          <div class="zoom-container overflow-hidden rounded-3xl border-2 border-line bg-white shadow-sh cursor-zoom-in" id="zoomContainer" style="touch-action: pan-y;">
<img
              id="zoomImage"
              src={c.img}
              alt={`${c.n} para arriendo en Punta Arenas`}
              class="h-full w-full object-contain transition-transform duration-200 ease-out"
              loading="eager"
              width="600"
              height="900"
              decoding="async"
              draggable="false"
            />
          </div>
          <!-- Código badge -->
          <span class="absolute left-4 top-4 rounded-full bg-m600 px-3 py-1 text-[.75rem] font-extrabold text-white shadow-sh">
            Disfraz #{codigo}
          </span>
          <p class="mt-2 text-center text-[.75rem] text-ink2">
            <span class="min-[900px]:hidden">🔍 Pellizca para ampliar · doble toque para volver</span>
            <span class="hidden min-[900px]:inline">🔍 Pasa el mouse para ampliar</span>
          </p>
        </div>

        <!-- Info -->
        <div class="info-col flex flex-col gap-3">
          <!-- Categorías y género -->
          <div class="space-y-3">
            <div class="flex flex-wrap items-center gap-2">
              {c.cats.map((catId, i) => {
                const cat = catById(catId);
                return (
                  <a href={ir(`/catalogo/?cat=${catId}`)} class={`pill-cat ${i % 2 === 0 ? 'pill-cat-main' : 'pill-cat-alt'}`}>
                    {cat.i} {cat.n}
                  </a>
                );
              })}
              <span class="pill-cat pill-cat-gen">
                {c.pub === 'mujer' ? '👩 Mujer' : c.pub === 'hombre' ? '👤 Hombre' : '🧑 Unisex'} / Solo Adultos
              </span>
            </div>
            <h1 class="font-ft text-[2rem] leading-tight text-ink min-[900px]:text-[2.4rem]">{c.n}</h1>
            <p class="text-[.85rem] font-medium text-ink2">
              Código de inventario: <b class="text-m600">#{codigo}</b>
            </p>
          </div>

          <!-- Descripción -->
          <div class="space-y-3 rounded-2xl border-[1.5px] border-line bg-white p-4 shadow-sh">
            {descParrafos.map((p) => (
              <p class="text-[.92rem] leading-[1.65] text-ink2">{p}</p>
            ))}
          </div>

          <!-- Tallas -->
          <div id="tallasSection" class="space-y-3">
            <b class="flex items-center gap-2 text-[.9rem] font-bold text-ink">🏷️ Tallas disponibles:</b>
            <div class="grid grid-cols-3 gap-3">
              {c.tl.map((t) => (
                <button
                  type="button"
                  class="talla-btn"
                  data-t={t}
                  aria-label={`Talla ${displayTalla(t)}${TALLA_GUIA[t] ? ', estatura ' + TALLA_GUIA[t] : ''}`}
                >
                  <span class="talla-nom">Talla {displayTalla(t)}</span>
                  <span class="talla-sub">{TALLA_GUIA[t] ? `Estatura ${TALLA_GUIA[t]}` : 'Estatura referencial'}</span>
                </button>
              ))}
            </div>
          </div>

          <!-- Tarjeta de arriendo: tarifa, garantía, limpieza y acciones -->
          <div class="pricing-card rounded-2xl border-2 border-line p-4 shadow-sh">
            <div class="flex flex-col gap-3 border-b border-line pb-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <span class="block text-[.7rem] font-extrabold uppercase tracking-[.08em] text-m500">Tarifa de arriendo</span>
                <div class="flex items-baseline gap-2">
                  <span class="font-ft text-[2.1rem] font-extrabold leading-none text-ink">$15.000</span>
                  <span class="text-[.8rem] font-semibold text-ink2">CLP / período completo</span>
                </div>
              </div>
              <div class="inline-flex items-center gap-2 self-start rounded-xl border border-line bg-white px-3 py-1.5 text-[.75rem] font-bold text-ink sm:self-auto">
                <svg viewBox="0 0 24 24" class="h-4 w-4 text-m600" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z"/></svg>
                Incluye 3 días (retiro, uso y entrega)
              </div>
            </div>

            <div class="space-y-2.5 py-3.5 text-[.8rem] text-ink2">
              <div class="flex items-center justify-between gap-3">
                <span class="flex items-center gap-1.5 font-medium"><i class="dot dot-green"></i> Garantía reembolsable:</span>
                <b class="text-ink">$15.000 o $20.000 (se reintegra al devolver)</b>
              </div>
              <div class="flex items-center justify-between gap-3">
                <span class="flex items-center gap-1.5 font-medium"><i class="dot dot-mora"></i> Limpieza y desinfección:</span>
                <b class="text-[#0c7a56]">¡Incluida sin costo adicional!</b>
              </div>
            </div>

            <div class="space-y-3 pt-1">
              <button
                type="button"
                class="btn btn-mora btn-lg w-full"
                id="addCartBtn"
                data-id={c.id}
              >
                🛒 Agregar a mi arriendo
              </button>
              <a
                href={waHref}
                target="_blank"
                rel="noopener"
                class="btn btn-wsp btn-lg w-full"
              >
                💬 Consultar disponibilidad por WhatsApp
              </a>
            </div>

            <div class="mt-4 flex items-center justify-center gap-3 border-t border-line pt-4 text-[.75rem] font-semibold text-ink2">
              <button type="button" class="link-mini" id="copyLinkBtn" data-url={pageUrl}>🔗 Copiar enlace</button>
              <span class="opacity-40">•</span>
              <div class="relative">
                <button type="button" class="link-mini" id="shareBtn" aria-expanded="false" aria-haspopup="true">📲 Compartir</button>
                <div id="shareMenu" class="share-menu hidden" role="menu" aria-label="Compartir por">
                  <a class="share-item" role="menuitem" href={waShare} target="_blank" rel="noopener">💬 WhatsApp</a>
                  <a class="share-item" role="menuitem" href={fbShare} target="_blank" rel="noopener">👍 Facebook</a>
                  <button type="button" class="share-item" role="menuitem" data-net="instagram">📸 Instagram</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Disfraces similares -->
    {similares.length > 0 && (
      <section class="mx-auto max-w-[1220px] px-4 pb-12">
        <h2 class="sec-sm rv">🎭 Disfraces similares</h2>
        <p class="sec-sub rv">Otros disfraces que te pueden gustar</p>
        <div class="relative">
          <button type="button" id="simPrev" class="car-arrow car-arrow-l" aria-label="Ver disfraces anteriores" disabled>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button type="button" id="simNext" class="car-arrow car-arrow-r" aria-label="Ver más disfraces">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
          <div id="simTrack" class="flex gap-3 overflow-x-auto pb-4 snap-x snap-mandatory scrollbar-hide" style="scrollbar-width: none; -ms-overflow-style: none;">
            {similares.map((s) => {
              const sSlug = disfrazSlug(s);
              return (
                <a href={ir(`/disfraz/${sSlug}/`)} class="group block w-[160px] shrink-0 snap-start overflow-hidden rounded-2xl border-[1.5px] border-line bg-white shadow-sh transition hover:-translate-y-1 hover:shadow-sh2 min-[560px]:w-[200px]">
                  <div class="relative aspect-[2/3] overflow-hidden bg-[#f0eaff]">
                    <img src={s.img} alt={`${s.n} en arriendo en Punta Arenas`} class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105" loading="lazy" decoding="async" width="200" height="300" />
                    <span class="absolute left-2 top-2 rounded-full bg-m600/90 px-2 py-0.5 text-[.65rem] font-extrabold text-white">#{String(s.id).padStart(3, '0')}</span>
                  </div>
                  <div class="p-3">
                    <h3 class="text-[.9rem] font-semibold text-ink line-clamp-2">{s.n}</h3>
                    <span class="mt-1 block text-[.75rem] font-bold text-m500">{catById(s.t).i} {catById(s.t).n}</span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )}
  </main>

  <script is:inline set:html={`window.__DISFRACES__ = ${disfracesJSON};`} />

  <script is:inline>
    // ═══ Zoom de la foto: pellizco con dos dedos + arrastre con uno ═══
    // Se maneja con tres números (escala, desplazamiento x/y) en vez de
    // transform-origin al tanto. Así el punto que queda bajo los dedos se
    // mantiene quieto, el zoom se puede usar varias veces seguidas y, ya
    // ampliado, un dedo mueve la foto en vez de bajar la página.
    (function () {
      const box = document.getElementById('zoomContainer');
      const img = document.getElementById('zoomImage');
      if (!box || !img) return;

      const MIN = 1;
      const MAX = 5;
      const DOBLE = 2.6; // nivel del doble toque
      let s = 1, tx = 0, ty = 0;
      let pellizco = null;
      let arrastre = null;
      let ultimoToque = 0;

      const medidas = () => box.getBoundingClientRect();

      /* La imagen no se sale del marco: si está más grande que la caja, el
         desplazamiento queda entre los dos límites. */
      function ajustar() {
        const r = medidas();
        const w = img.offsetWidth * s;
        const h = img.offsetHeight * s;
        tx = w <= r.width ? (r.width - w) / 2 : Math.min(0, Math.max(r.width - w, tx));
        ty = h <= r.height ? (r.height - h) / 2 : Math.min(0, Math.max(r.height - h, ty));
      }

      function pintar() {
        ajustar();
        img.style.transformOrigin = '0 0';
        img.style.transform = 'translate3d(' + tx + 'px,' + ty + 'px,0) scale(' + s + ')';
        // Con la foto ampliada el dedo tiene que mover la foto, no la página.
        box.style.touchAction = s > 1.01 ? 'none' : 'pan-y';
      }

      const fijar = (nuevoS, cx, cy) => {
        const r = medidas();
        // Qué punto de la foto está bajo (cx, cy) antes de cambiar la escala
        const ux = (cx - tx) / s;
        const uy = (cy - ty) / s;
        s = Math.min(Math.max(nuevoS, MIN), MAX);
        tx = cx - ux * s;
        ty = cy - uy * s;
        pintar();
      };

      const distancia = (t) => Math.hypot(t[0].clientX - t[1].clientX, t[0].clientY - t[1].clientY);
      const enCaja = (t) => {
        const r = medidas();
        return { x: t.clientX - r.left, y: t.clientY - r.top };
      };

      // ── Ratón: al pasar el mouse se amplía hacia el puntero ──
      // (solo en dispositivos con mouse real; en táctil el zoom es con pellizco).
      // Va por transform-origin para que el punto bajo el cursor se quede
      // quieto y el mouse recorra la foto de la cabeza a los pies.
      if (matchMedia('(hover: hover)').matches) {
        const ZOOM_PC = 2.5;
        box.addEventListener('mouseenter', () => {
          img.style.transition = 'transform 0.06s linear';
          img.style.transformOrigin = '50% 50%';
          img.style.transform = `scale(${ZOOM_PC})`;
        });
        box.addEventListener('mousemove', (e) => {
          const r = medidas();
          const x = ((e.clientX - r.left) / r.width) * 100;
          const y = ((e.clientY - r.top) / r.height) * 100;
          img.style.transformOrigin = `${x}% ${y}%`;
        });
        box.addEventListener('mouseleave', () => {
          img.style.transition = 'transform 0.3s ease-out';
          img.style.transform = 'scale(1)';
          img.style.transformOrigin = '50% 50%';
        });
      }
      // ── Táctil ──
      box.addEventListener('touchstart', (e) => {
        img.style.transition = 'none';

        // Dos dedos: pellizco. No cuenta para el doble toque —si lo contara,
        // el dedo que viene después de cerrar el pellizco se leería como un
        // doble toque y la foto volvería a su tamaño sin querer.
        if (e.touches.length >= 2) {
          const a = enCaja(e.touches[0]);
          const b = enCaja(e.touches[1]);
          pellizco = {
            d0: distancia(e.touches),
            s0: s,
            // punto medio del pellizco, para que no se "resbale"
            mx: (a.x + b.x) / 2,
            my: (a.y + b.y) / 2,
          };
          arrastre = null;
          return;
        }

        // Un dedo
        const ahora = Date.now();
        if (ahora - ultimoToque < 300) {
          ultimoToque = 0;
          if (s > 1.01) { s = 1; tx = 0; ty = 0; } else { s = DOBLE; }
          img.style.transition = 'transform .25s ease-out';
          pintar();
          e.preventDefault();
          return;
        }
        ultimoToque = ahora;

        if (s > 1.01) {
          // Ya está ampliada: el dedo mueve la foto en vez de bajar la página.
          arrastre = { x: e.touches[0].clientX, y: e.touches[0].clientY, tx, ty };
          pellizco = null;
        }
      }, { passive: false });

      box.addEventListener('touchmove', (e) => {
        if (pellizco && e.touches.length === 2) {
          e.preventDefault();
          const a = enCaja(e.touches[0]);
          const b = enCaja(e.touches[1]);
          const nuevoS = pellizco.s0 * (distancia(e.touches) / pellizco.d0);
          // el punto medio se mantiene bajo los dedos: si además se movieron,
          // se le suma el desplazamiento para que no "resbale"
          fijar(nuevoS, pellizco.mx, pellizco.my);
          pellizco.mx += (a.x + b.x) / 2 - pellizco.mx;
          pellizco.my += (a.y + b.y) / 2 - pellizco.my;
        } else if (arrastre && e.touches.length === 1) {
          e.preventDefault();
          tx = arrastre.tx + (e.touches[0].clientX - arrastre.x);
          ty = arrastre.ty + (e.touches[0].clientY - arrastre.y);
          pintar();
        }
      }, { passive: false });

      const soltar = (e) => {
        if (e.touches.length > 0) return;
        pellizco = null;
        arrastre = null;
        img.style.transition = 'transform .25s ease-out';
      };
      box.addEventListener('touchend', soltar, { passive: true });
      box.addEventListener('touchcancel', soltar, { passive: true });

      pintar();
    })();

    // ── Copiar al portapapeles (con respaldo si la API no está disponible) ──
    function copiarTexto(texto) {
      return new Promise(function (resolve) {
        function respaldo(t) {
          try {
            const ta = document.createElement('textarea');
            ta.value = t;
            ta.setAttribute('readonly', '');
            ta.style.position = 'fixed';
            ta.style.top = '-1000px';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            ta.setSelectionRange(0, t.length);
            const ok = document.execCommand('copy');
            document.body.removeChild(ta);
            return ok;
          } catch (e) {
            return false;
          }
        }
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(texto).then(
            function () { resolve(true); },
            function () { resolve(respaldo(texto)); }
          );
        } else {
          resolve(respaldo(texto));
        }
      });
    }

    function avisar(msg) {
      let t = document.getElementById('__aviso');
      if (!t) {
        t = document.createElement('div');
        t.id = '__aviso';
        t.className = 'aviso-flotante';
        document.body.appendChild(t);
      }
      t.textContent = msg;
      void t.offsetWidth;
      t.classList.add('on');
      clearTimeout(t.__t);
      t.__t = setTimeout(function () { t.classList.remove('on'); }, 2400);
    }

    const enlaceFicha = document.getElementById('copyLinkBtn')?.dataset.url || location.href;

    document.getElementById('copyLinkBtn')?.addEventListener('click', async function () {
      const ok = await copiarTexto(this.dataset.url || location.href);
      this.textContent = ok ? '✅ ¡Enlace copiado!' : '❌ No se pudo copiar';
      avisar(ok ? 'Enlace copiado al portapapeles' : 'No se pudo copiar el enlace');
      setTimeout(() => { this.textContent = '🔗 Copiar enlace'; }, 2000);
    });

    // ── Menú de compartir: WhatsApp · Facebook · Instagram ──
    const shareBtn = document.getElementById('shareBtn');
    const shareMenu = document.getElementById('shareMenu');
    const cerrarShare = () => {
      shareMenu?.classList.add('hidden');
      shareBtn?.setAttribute('aria-expanded', 'false');
    };
    shareBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const abrir = shareMenu?.classList.contains('hidden');
      if (abrir && shareMenu) {
        // Abre hacia donde haya más espacio para que nunca quede cortado.
        const r = shareBtn.getBoundingClientRect();
        shareMenu.classList.toggle('arriba', window.innerHeight - r.bottom < 160);
      }
      shareMenu?.classList.toggle('hidden', !abrir);
      shareBtn.setAttribute('aria-expanded', abrir ? 'true' : 'false');
    });
    document.addEventListener('click', (e) => {
      if (!shareMenu?.contains(e.target) && e.target !== shareBtn) cerrarShare();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrarShare(); });
    shareMenu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', cerrarShare));

    // Instagram no tiene enlace web para compartir: en el teléfono abrimos el
    // menú nativo (donde aparece Instagram) y en escritorio copiamos el enlace
    // y abrimos Instagram para pegarlo.
    shareMenu?.querySelector('[data-net="instagram"]')?.addEventListener('click', async function () {
      if (navigator.share) {
        try {
          await navigator.share({ title: document.title, text: document.title, url: enlaceFicha });
          cerrarShare();
          return;
        } catch (err) {
          if (err && err.name === 'AbortError') { cerrarShare(); return; }
        }
      }
      const ok = await copiarTexto(enlaceFicha);
      avisar(ok ? 'Enlace copiado: pégalo en tu Instagram 📸' : 'Copia el enlace y pégalo en tu Instagram');
      window.open('https://www.instagram.com/', '_blank', 'noopener');
      cerrarShare();
    });

    // Añadir al arriendo con la talla elegida
    let selectedTalla = '';
    const tallaSection = document.getElementById('tallasSection');
    const tallas = tallaSection?.querySelectorAll('.talla-btn');
    tallas?.forEach((t) => {
      t.addEventListener('click', function () {
        selectedTalla = this.dataset.t;
        tallas.forEach((x) => x.classList.remove('on'));
        this.classList.add('on');
      });
    });
    // Si solo hay una talla, seleccionarla automáticamente
    if (tallas && tallas.length === 1) {
      tallas[0].click();
    }

    document.getElementById('addCartBtn')?.addEventListener('click', function () {
      const id = Number(this.dataset.id);
      const talla = selectedTalla || (tallas && tallas.length === 1 ? tallas[0].dataset.t : '');
      if (!talla && tallas && tallas.length > 0) {
        // Resaltar la sección de tallas
        if (tallaSection) {
          tallaSection.classList.add('ring-2', 'ring-[#c0392b]', 'ring-offset-2', 'rounded-xl', 'bg-[#fdecea]', 'p-3');
          tallaSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
          setTimeout(() => {
            tallaSection.classList.remove('ring-[#c0392b]', 'bg-[#fdecea]');
            tallaSection.classList.add('ring-[#0c7a56]', 'bg-[#e2f7ec]');
          }, 1500);
        }
        return;
      }
      if (talla && window.addItemToCart) {
        window.addItemToCart(id, talla);
      }
      if (window.openMiniCart) {
        window.openMiniCart();
      }
    });

    // Flechas del carrusel de disfraces similares
    (function () {
      const track = document.getElementById('simTrack');
      const prev = document.getElementById('simPrev');
      const next = document.getElementById('simNext');
      if (!track || !prev || !next) return;
      const paso = () => Math.max(200, Math.round(track.clientWidth * 0.8));
      const sync = () => {
        const max = track.scrollWidth - track.clientWidth - 1;
        prev.disabled = track.scrollLeft <= 1;
        next.disabled = track.scrollLeft >= max;
      };
      prev.addEventListener('click', () => track.scrollBy({ left: -paso(), behavior: 'smooth' }));
      next.addEventListener('click', () => track.scrollBy({ left: paso(), behavior: 'smooth' }));
      track.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    })();

    // La columna de datos sigue el scroll en escritorio cuando alcanza a
    // caber completa en pantalla. Sin scroll interno: eso trababa el
    // desplazamiento de la página al girar la rueda sobre la columna.
    (function () {
      const info = document.querySelector('.info-col');
      if (!info) return;
      const mq = window.matchMedia('(min-width: 900px)');
      const ajustar = () => {
        info.classList.remove('can-stick');
        if (!mq.matches) return;
        const libre = window.innerHeight - 130; // header pegajoso + margen
        if (info.offsetHeight <= libre) info.classList.add('can-stick');
      };
      ajustar();
      window.addEventListener('resize', ajustar);
      if (document.fonts?.ready) document.fonts.ready.then(ajustar);
    })();
  </script>
</Layout>

