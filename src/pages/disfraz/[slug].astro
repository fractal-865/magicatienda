    mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
  }
  .sim-track {
    display: flex;
    width: max-content;
    animation: sim-scroll 95s linear infinite;
  }
  .sim-track.paused,
  .sim-band:hover .sim-track,
  .sim-band:focus-within .sim-track {
