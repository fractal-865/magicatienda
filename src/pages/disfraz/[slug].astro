  /* ── Aviso flotante (copia / compartir) ──
     Es global porque el elemento lo crea el script en tiempo de ejecución
     (los estilos con ámbito no lo alcanzarían). */
  :global(.aviso-flotante) {
    position: fixed;
    left: 50%;
