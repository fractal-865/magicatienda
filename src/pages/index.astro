---
import Layout from '../layouts/Layout.astro';
import Urgencia from '../components/Urgencia.astro';
import Catalogo from '../components/Catalogo.astro';
import Tarifas from '../components/Tarifas.astro';
import Promos from '../components/Promos.astro';
import Fechas from '../components/Fechas.astro';
import Como from '../components/Como.astro';
import Pagos from '../components/Pagos.astro';
import Testimonios from '../components/Testimonios.astro';
import Mapa from '../components/Mapa.astro';
import Contacto from '../components/Contacto.astro';
import Faq from '../components/Faq.astro';
import Club from '../components/Club.astro';
---

<Layout>
  <main id="main" class="relative z-[1]">
    <Urgencia />
    <Catalogo />
    <Tarifas />
    <Promos />
    <Fechas />
    <Como />
    <Pagos />
    <Testimonios />
    <Mapa />
    <Contacto />
    <Faq />
    <Club />
  </main>
</Layout>
